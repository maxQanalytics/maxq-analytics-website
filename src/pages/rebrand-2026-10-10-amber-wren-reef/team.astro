---
// Rebrand edition 2026-10-10 (unlisted): team page. People as on src/pages/team.astro.
import Layout from '../../rebrand/2026-10-10/Layout.astro';
const people = [
          {
            photo: '/team/philip.png',
            name: 'Philip Boontje',
            role: 'Guild Lead',
            bio: 'Designed the Semantic Nexus while serving as CFO at ClubCollect. Combines data architecture depth with executive financial experience.',
            linkedin: 'https://www.linkedin.com/in/philipboontje',
          },
          {
            photo: '/team/jeroen.png',
            name: 'Jeroen de Vries',
            role: 'Medior Data Engineer',
            bio: 'Specialises in Python automation and cloud-native data applications. Turns complex pipeline requirements into clean, maintainable code.',
            linkedin: 'https://www.linkedin.com/in/jeroen-de-vries-014086224/',
          },
          {
            photo: '/team/xavier.png',
            name: 'Xavier Paredes',
            role: 'Medior Data Engineer',
            bio: 'Seven years across media, gaming, and retail — from King to Looker Consulting. Brings enterprise-scale data modelling to every engagement.',
            linkedin: 'https://www.linkedin.com/in/xparedesfortuny',
          },
          {
            photo: '/team/sarah.png',
            name: 'Sarah Thiébault',
            role: 'Medior Data Engineer',
            bio: 'Product owner of the Analytics Assistant — the nao-based agent that answers data questions in Slack and through Claude. Leads its roadmap and client rollouts.',
            linkedin: 'https://www.linkedin.com/in/sarah-thiebault-2aba2a114/',
          },
          {
            photo: '/team/valentin.png',
            name: 'Valentin Cathelain',
            role: 'Medior Data Engineer',
            bio: 'Develops the Quality Guardian alongside the team — building out check configuration, Slack workflows, and client-side implementation.',
            linkedin: 'https://www.linkedin.com/in/valentincathelain/',
          },
          {
            photo: '/team/conno.png',
            name: 'Conno Kuyt',
            role: 'Medior Data Engineer',
            bio: 'Works as data architect across multiple client engagements — designing Semantic Nexus implementations and guiding them from first model to operations.',
            linkedin: 'https://www.linkedin.com/in/connokuyt/',
          },
          {
            photo: '/team/daniel.png',
            name: 'Daniël Laurentius',
            role: 'Junior Data Engineer',
            bio: 'Bridges data engineering and financial operations. Keeps client reporting sharp and the company\'s own numbers in order.',
            linkedin: 'https://www.linkedin.com/in/dani%C3%ABl-laurentius-58224628a',
          },
          {
            photo: '/team/figo.png',
            name: 'Figo Spoelstra',
            role: 'Junior Data Engineer',
            bio: 'Apprentice to Jeroen. Supports pipeline development, follows up on data alerts and monitors client data models day to day.',
            linkedin: 'https://nl.linkedin.com/in/figo-spoelstra',
          },
        ];
---

<Layout title="Team — Maxq Analytics">
  <section class="pt-36 md:pt-44 pb-32 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="rb-reveal max-w-3xl mb-16">
        <p class="rb-label mb-4">Team</p>
        <h1 class="rb-h1 text-ink">People involved.</h1>
        <p class="text-lg text-ink/60 leading-relaxed mt-6 max-w-2xl">Our guild combines backgrounds in data engineering, financial operations, and software development. We work across the full data stack — from extraction to semantic layer — and stay involved from design till operations.</p>
      </div>
      <div class="rb-reveal rb-grid-cells grid-cols-2 lg:grid-cols-4 rounded-lg overflow-hidden">
        {people.map((p) => (
          <div class="p-4 md:p-6 flex flex-col">
            <div class="aspect-square rounded-md overflow-hidden mb-5 bg-[#f4f4f5]">
              <img src={p.photo} alt={p.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="rb-label !text-brand-600 mb-1.5">{p.role}</div>
            <div class="rb-h3 text-[17px] text-ink mb-2">{p.name}</div>
            <p class="text-[13px] text-ink/60 leading-relaxed mb-4">{p.bio}</p>
            {p.linkedin && <a href={p.linkedin} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1.5 rb-label hover:!text-brand-600 transition-colors">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
