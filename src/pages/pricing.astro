---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Pricing — Maxq Analytics">
  <SiteNav />

  <section id="pricing" class="pt-32 pb-24 px-6 bg-ink text-cream overflow-hidden relative min-h-screen">
    <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full border border-dashed border-brand-600/10 -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>
    <div class="max-w-6xl mx-auto">
      <div class="text-xs font-mono font-medium text-brand-300 uppercase tracking-widest mb-4">Pricing</div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4" style="letter-spacing: -0.02em">The architecture is <span class="text-brand-300">free.</span><br>You pay for implementation.</h1>
      <p class="text-lg text-cream/50 max-w-2xl mb-12">No licensing fees. No per-seat pricing. No vendor lock-in. The Semantic Nexus is an open architecture: you own everything we build. You only pay our standard rate for the time it takes to set up and maintain.</p>

      <div class="grid md:grid-cols-3 gap-4">

        <!-- Architecture — highlighted -->
        <div class="bg-brand-600/10 border border-brand-600 rounded-xl p-9 flex flex-col transition-colors hover:border-brand-400">
          <div class="w-10 h-10 rounded-lg bg-brand-600/20 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3 class="text-base font-bold mb-1">Semantic Nexus Architecture</h3>
          <div class="text-4xl font-black mb-1" style="letter-spacing: -0.03em">€0</div>
          <div class="font-mono text-xs text-cream/35 uppercase tracking-wider mb-5">Free, always</div>
          <p class="text-cream/55 text-sm leading-relaxed">The full architecture framework, all five product components, and the three core frameworks. Freely available. We believe architecture should never be a barrier.</p>
        </div>

        <!-- Retainer -->
        <div class="bg-white/4 border border-white/10 rounded-xl p-9 flex flex-col transition-colors hover:border-white/20">
          <div class="w-10 h-10 rounded-lg bg-brand-600/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="10"/></svg>
          </div>
          <h3 class="text-base font-bold mb-1">Capacity</h3>
          <div class="text-4xl font-black mb-1" style="letter-spacing: -0.03em">From €3K<span class="text-lg font-normal opacity-40">/mo</span></div>
          <div class="font-mono text-xs text-cream/35 uppercase tracking-wider mb-5">3 full working days per month</div>
          <p class="text-cream/55 text-sm leading-relaxed">Ongoing implementation, maintenance, and data engineering. Scale up or down as needed. No long-term contracts required.</p>
        </div>

        <!-- Revenue-Based -->
        <div class="bg-white/4 border border-white/10 rounded-xl p-9 flex flex-col transition-colors hover:border-white/20">
          <div class="w-10 h-10 rounded-lg bg-brand-600/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="text-base font-bold mb-1">Sprints</h3>
          <div class="text-4xl font-black mb-1" style="letter-spacing: -0.03em">From €5k<span class="text-lg font-normal opacity-40">/sprint</span></div>
          <div class="font-mono text-xs text-cream/35 uppercase tracking-wider mb-5">Per sprint / one full work-week</div>
          <p class="text-cream/55 text-sm leading-relaxed">Each sprint is 40 hours of a medior data engineer. Scheduled monthly and stackable to accelerate delivery. Work pauses when the budget is reached, unless a follow-up sprint is agreed.</p>
        </div>

      </div>

      <p class="text-center mt-9 font-mono text-xs text-cream/25 uppercase tracking-wider">Underlying tool costs (extraction, warehouse, distribution, BI, AI) billed directly by vendors</p>
    </div>
  </section>

  <SiteFooter />
</Layout>
