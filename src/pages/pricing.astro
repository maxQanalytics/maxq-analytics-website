---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
const plans = [
  {
    "name": "Semantic Nexus Architecture",
    "price": "€0",
    "unit": "",
    "label": "Open source",
    "desc": "The full architecture framework and the three core frameworks and its embedded tooling is freely available. We believe software should not be a source of lock-in."
  },
  {
    "name": "Semantic Nexus Implementation",
    "price": "From €5k",
    "unit": "/sprint",
    "label": "One-week implementation sprints",
    "desc": "Each sprint is 40 hours of a medior data engineer. Scheduled monthly and stackable to accelerate delivery. Work pauses when the budget is reached, unless a follow-up sprint is agreed."
  },
  {
    "name": "Semantic Nexus Operations",
    "price": "From €2.5K",
    "unit": "/mo",
    "label": "Dedicated data partner",
    "desc": "Ongoing monitoring, systems maintenance, stack cost optimisation, quarterly framework adherence reviews, ad-hoc development requests and issue resolution."
  }
];
const footnote = "Underlying tool costs (extraction, warehouse, distribution, BI, AI) billed directly by vendors";
---

<Layout title="Pricing — Maxq Analytics">
  <SiteNav />

  <section id="pricing" class="pt-32 pb-24 px-6 bg-warm min-h-screen">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
      <h1 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Pricing</h1>
      <p class="text-lg text-ink/55 max-w-2xl mx-auto">The Semantic Nexus is an open architecture, so we charge implementation costs of the selected tooling and after delivery migrate to the operations phase, where we monitor, maintain and improve the data stack.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-4">

        <!-- Architecture — highlighted -->
        <div class="bg-cream rounded-xl p-8 flex flex-col border border-ink/10">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3 class="text-3xl font-bold text-ink mb-3 leading-tight" style="letter-spacing: -0.02em">Semantic Nexus<br>Architecture</h3>
          <div class="text-2xl font-black text-ink mb-1" style="letter-spacing: -0.02em">€0</div>
          <div class="font-mono text-xs text-brand-600 uppercase tracking-wider mb-5">Open source</div>
          <p class="text-ink/60 text-sm leading-relaxed">The full architecture framework and the three core frameworks and its embedded tooling is freely available. We believe software should not be a source of lock-in.</p>
        </div>
        <!-- Revenue-Based -->
        <div class="bg-cream rounded-xl p-8 flex flex-col border border-ink/10">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="text-3xl font-bold text-ink mb-3 leading-tight" style="letter-spacing: -0.02em">Semantic Nexus<br>Implementation</h3>
          <div class="text-2xl font-black text-ink mb-1" style="letter-spacing: -0.02em">From €5k<span class="text-sm font-normal text-ink/40">/sprint</span></div>
          <div class="font-mono text-xs text-brand-600 uppercase tracking-wider mb-5">One-week implementation sprints</div>
          <p class="text-ink/60 text-sm leading-relaxed">Each sprint is 40 hours of a medior data engineer. Scheduled monthly and stackable to accelerate delivery. Work pauses when the budget is reached, unless a follow-up sprint is agreed.</p>
        </div>
        <!-- Retainer -->
        <div class="bg-cream rounded-xl p-8 flex flex-col border border-ink/10">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="10"/></svg>
          </div>
          <h3 class="text-3xl font-bold text-ink mb-3 leading-tight" style="letter-spacing: -0.02em">Semantic Nexus<br>Operations</h3>
          <div class="text-2xl font-black text-ink mb-1" style="letter-spacing: -0.02em">From €2.5K<span class="text-sm font-normal text-ink/40">/mo</span></div>
          <div class="font-mono text-xs text-brand-600 uppercase tracking-wider mb-5">Dedicated data partner</div>
          <p class="text-ink/60 text-sm leading-relaxed">Ongoing monitoring, systems maintenance, stack cost optimisation, quarterly framework adherence reviews, ad-hoc development requests and issue resolution.</p>
        </div>

      </div>

      <p class="text-center mt-9 font-mono text-xs text-ink/40 uppercase tracking-wider">Underlying tool costs (extraction, warehouse, distribution, BI, AI) billed directly by vendors</p>
    </div>
  </section>

  <!-- Layout options for review (same text as above). Remove the ones not chosen. -->

  <!-- Option A: three numbered steps with connectors -->
  <section class="py-20 px-6 bg-cream border-t border-ink/10">
    <div class="max-w-5xl mx-auto">
      <p class="font-mono text-xs text-brand-600 uppercase tracking-widest mb-8">Option A · three steps</p>
      <div class="grid md:grid-cols-3 gap-6">
        {plans.map((p, i) => (
          <div class="relative bg-white rounded-2xl p-8 border border-ink/10 flex flex-col">
            <span class="w-8 h-8 rounded-full bg-brand-600 text-cream font-black text-xs flex items-center justify-center mb-6">{i + 1}</span>
            <h3 class="text-2xl font-bold text-ink leading-tight mb-4" style="letter-spacing: -0.02em">{p.name}</h3>
            <div class="text-3xl font-black text-brand-600 mb-1" style="letter-spacing: -0.02em">{p.price}<span class="text-sm font-normal text-ink/40">{p.unit}</span></div>
            <div class="font-mono text-xs text-ink/50 uppercase tracking-wider mb-5">{p.label}</div>
            <p class="text-ink/60 text-sm leading-relaxed">{p.desc}</p>
            {i < plans.length - 1 && (
              <div class="hidden md:flex absolute top-1/2 -right-6 w-6 -translate-y-1/2 items-center justify-center text-ink/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Option B: one dark ledger, a row per phase -->
  <section class="py-20 px-6 bg-ink text-cream">
    <div class="max-w-5xl mx-auto">
      <p class="font-mono text-xs text-brand-300 uppercase tracking-widest mb-8">Option B · one ledger</p>
      <div class="border border-white/15 rounded-2xl overflow-hidden divide-y divide-white/15">
        {plans.map((p) => (
          <div class="grid md:grid-cols-[1.1fr_0.9fr_1.6fr] gap-6 md:gap-10 p-8">
            <div>
              <h3 class="text-xl font-bold text-cream leading-tight" style="letter-spacing: -0.01em">{p.name}</h3>
            </div>
            <div>
              <div class="text-2xl font-black text-cream" style="letter-spacing: -0.02em">{p.price}<span class="text-sm font-normal text-white/50">{p.unit}</span></div>
              <div class="font-mono text-xs text-brand-300 uppercase tracking-wider mt-1">{p.label}</div>
            </div>
            <p class="text-white/80 text-sm leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 font-mono text-xs text-white/60 uppercase tracking-wider">{footnote}</p>
    </div>
  </section>

  <!-- Option C: editorial rows, name left, price right -->
  <section class="py-20 px-6 bg-warm">
    <div class="max-w-4xl mx-auto">
      <p class="font-mono text-xs text-brand-600 uppercase tracking-widest mb-4">Option C · editorial rows</p>
      {plans.map((p) => (
        <div class="border-t border-ink/15 py-10 md:grid md:grid-cols-[1fr_auto] md:gap-12 items-start">
          <div>
            <div class="font-mono text-xs text-brand-600 uppercase tracking-wider mb-2">{p.label}</div>
            <h3 class="text-3xl font-bold text-ink mb-3" style="letter-spacing: -0.02em">{p.name}</h3>
            <p class="text-ink/60 leading-relaxed max-w-xl">{p.desc}</p>
          </div>
          <div class="mt-6 md:mt-0 md:text-right">
            <div class="text-4xl font-black text-ink" style="letter-spacing: -0.03em">{p.price}</div>
            <div class="font-mono text-xs text-ink/40 uppercase tracking-wider mt-1">{p.unit ? p.unit.replace('/', 'per ') : 'no charge'}</div>
          </div>
        </div>
      ))}
      <div class="border-t border-ink/15 pt-6 font-mono text-xs text-ink/40 uppercase tracking-wider">{footnote}</div>
    </div>
  </section>

  <SiteFooter />
</Layout>
