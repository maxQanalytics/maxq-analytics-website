---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
const plans = [
  {
    "name": "Architecture",
    "price": "€0",
    "unit": "",
    "label": "Celebrating open source",
    "desc": "The full architecture, the three core frameworks and its embedded tooling are freely available. We believe software should not be a source of lock-in."
  },
  {
    "name": "Implementation",
    "price": "€5.0k",
    "unit": "/sprint",
    "label": "Building your nexus",
    "desc": "Each sprint is 40 hours of a medior data engineer, scheduled one or two months in advance, stackable to accelerate delivery. When the data-stack under management grows, follow-up sprints are scoped together."
  },
  {
    "name": "Operations",
    "price": "€2.5k",
    "unit": "/mo",
    "label": "Maintaining the impact",
    "desc": "Ongoing monitoring, systems maintenance, stack cost optimisation, quarterly framework adherence reviews, ad-hoc development requests and issue resolution."
  }
];
const footnote = "Underlying tool costs (extraction, warehouse, distribution, BI, AI) billed directly by vendors";
---

<Layout title="Pricing — Maxq Analytics">
  <SiteNav />

  <section id="pricing" class="pt-32 pb-24 px-6 bg-warm min-h-screen">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
      <h1 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Pricing</h1>
      <p class="text-lg text-ink/55 max-w-2xl mx-auto">The Semantic Nexus is an open architecture, so we charge implementation costs of the selected tooling and after delivery migrate to the operations phase. Here we monitor, maintain and improve the data stack.</p>
      </div>

      <div class="border border-ink/15 rounded-2xl overflow-hidden divide-y divide-ink/15 bg-cream">
        {plans.map((p) => (
          <div class="grid md:grid-cols-[1.1fr_0.9fr_1.6fr] gap-6 md:gap-10 p-8">
            <div>
              <h3 class="text-xl font-bold text-ink leading-tight" style="letter-spacing: -0.01em">{p.name}</h3>
            </div>
            <div>
              <div class="text-2xl font-black text-ink" style="letter-spacing: -0.02em">{p.price}<span class="text-sm font-normal text-ink/40">{p.unit}</span></div>
              <div class="font-mono text-xs text-brand-600 uppercase tracking-wider mt-1">{p.label}</div>
            </div>
            <p class="text-ink/60 text-sm leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-9 text-center font-mono text-xs text-ink/40 uppercase tracking-wider">{footnote}</p>
    </div>
  </section>

  <SiteFooter />
</Layout>
