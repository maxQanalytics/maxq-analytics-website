<script>
  const companies = [
    {
      name: 'DXM Manufacturing Ltd.',
      orgId: 'Org #2847',
      plan: 'Standard',
      actual: '€4,122',
      plans: [
        { rev: '€4,514', deltaEur: '+€391',  deltaPct: '+9%',   positive: true,  best: false },
        { rev: '€4,402', deltaEur: '+€279',  deltaPct: '+7%',   positive: true,  best: false },
        { rev: '€8,425', deltaEur: '+€4,303',deltaPct: '+104%', positive: true,  best: true  },
        { rev: '€9,379', deltaEur: '+€5,257',deltaPct: '+128%', positive: true,  best: false },
      ],
      volumes: [
        { label: 'Active users',  value: '1,037' },
        { label: 'Transactions',  value: '1,235' },
        { label: 'Events',        value: '2,118' },
      ],
    },
    {
      name: 'Northfield Logistics B.V.',
      orgId: 'Org #5512',
      plan: 'Standard',
      actual: '€3,240',
      plans: [
        { rev: '€3,890', deltaEur: '+€650',  deltaPct: '+20%',  positive: true,  best: false },
        { rev: '€5,120', deltaEur: '+€1,880',deltaPct: '+58%',  positive: true,  best: true  },
        { rev: '€4,780', deltaEur: '+€1,540',deltaPct: '+48%',  positive: true,  best: false },
        { rev: '€6,210', deltaEur: '+€2,970',deltaPct: '+92%',  positive: true,  best: false },
      ],
      volumes: [
        { label: 'Active users',  value: '2,841' },
        { label: 'Transactions',  value: '4,203' },
        { label: 'Events',        value: '847'   },
      ],
    },
    {
      name: 'Barq Innovations S.A.',
      orgId: 'Org #1094',
      plan: 'Plus',
      actual: '€5,890',
      plans: [
        { rev: '€4,120', deltaEur: '-€1,770',deltaPct: '-30%',  positive: false, best: false },
        { rev: '€5,890', deltaEur: '+€0',    deltaPct: '0%',    positive: true,  best: false },
        { rev: '€9,340', deltaEur: '+€3,450',deltaPct: '+59%',  positive: true,  best: true  },
        { rev: '€11,200',deltaEur: '+€5,310',deltaPct: '+90%',  positive: true,  best: false },
      ],
      volumes: [
        { label: 'Active users',  value: '389'   },
        { label: 'Transactions',  value: '8,740' },
        { label: 'Events',        value: '1,204' },
      ],
    },
  ];

  function updateCalculator(index) {
    const c = companies[index];

    // Header
    document.querySelector('[data-calc="client-name"]').textContent = c.name;
    document.querySelector('[data-calc="org-id"]').textContent = c.orgId;
    document.querySelector('[data-calc="current-plan"]').textContent = c.plan;
    document.querySelector('[data-calc="actual-revenue"]').textContent = c.actual;

    // Plan cards
    c.plans.forEach((plan, i) => {
      const card    = document.querySelector(`[data-plan-card="${i}"]`);
      const badge   = document.querySelector(`[data-plan-badge="${i}"]`);
      const revEl   = document.querySelector(`[data-plan-rev="${i}"]`);
      const eurEl   = document.querySelector(`[data-plan-delta-eur="${i}"]`);
      const pctEl   = document.querySelector(`[data-plan-delta-pct="${i}"]`);
      const label   = card.querySelector('p.font-mono');

      revEl.textContent = plan.rev;
      eurEl.textContent = plan.deltaEur;
      pctEl.textContent = plan.deltaPct;

      // Delta colours
      const positiveClasses = ['text-emerald-600', 'font-semibold'];
      const negativeClasses = ['text-red-500',     'font-semibold'];
      const bestEurClasses  = ['text-brand-600',   'font-bold'];
      const bestPctClasses  = ['text-brand-600',   'font-semibold'];
      const neutralPctClass = ['text-ink/50'];

      eurEl.className = 'font-mono text-xs';
      pctEl.className = 'font-mono text-xs';

      if (plan.best) {
        eurEl.classList.add(...bestEurClasses);
        pctEl.classList.add(...bestPctClasses);
      } else if (plan.positive) {
        eurEl.classList.add(...positiveClasses);
        pctEl.classList.add(...neutralPctClass);
      } else {
        eurEl.classList.add(...negativeClasses);
        pctEl.classList.add(...negativeClasses);
      }

      // Card highlight
      if (plan.best) {
        card.style.border         = '2px solid #1a4fff';
        card.style.backgroundColor= 'rgb(238,242,255)';
        label.style.color         = '#1a4fff';
        badge.classList.remove('hidden');
      } else {
        card.style.border         = '1px solid rgba(10,10,15,0.1)';
        card.style.backgroundColor= '';
        label.style.color         = '';
        badge.classList.add('hidden');
      }
    });

    // Volumes
    c.volumes.forEach((vol, i) => {
      document.querySelector(`[data-vol-label="${i}"]`).textContent = vol.label;
      document.querySelector(`[data-vol-value="${i}"]`).textContent = vol.value;
    });

    // Selector buttons
    document.querySelectorAll('[data-company-btn]').forEach((btn, i) => {
      if (i === index) {
        btn.className = 'px-4 py-2 rounded-full text-sm font-medium border transition-all duration-150 bg-ink text-cream border-ink';
      } else {
        btn.className = 'px-4 py-2 rounded-full text-sm font-medium border transition-all duration-150 bg-cream text-ink/60 border-ink/15 hover:border-ink/40';
      }
    });
  }

  document.querySelectorAll('[data-company-btn]').forEach((btn) => {
    btn.addEventListener('click', () => updateCalculator(Number(btn.dataset.companyBtn)));
  });
</script>
