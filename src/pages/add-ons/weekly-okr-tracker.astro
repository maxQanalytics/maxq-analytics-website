              <!-- Data points -->
              <circle cx="28"  cy="55" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="84"  cy="51" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="140" cy="53" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="196" cy="62" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="252" cy="42" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <!-- X-axis labels -->
              <text x="28"  y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 6</text>
              <text x="84"  y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 13</text>
              <text x="140" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 20</text>
              <text x="196" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 27</text>
              <text x="252" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">May 4</text>
              <!-- Callout: Outage at (196,62) -->
              <line x1="196" y1="62" x2="162" y2="49" stroke="#FFB347" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.65"/>
              <rect x="54" y="37" width="107" height="14" rx="3" fill="rgba(10,22,46,0.95)" stroke="#FFB347" stroke-width="1.3"/>
              <text x="61" y="47" fill="#FFB347" font-size="7.5" font-weight="bold" font-family="sans-serif">⚠ Outage — 5 hrs (Tue)</text>
              <!-- Callout: Skill update at (252,42) -->
              <line x1="252" y1="42" x2="216" y2="28" stroke="#4FC3F7" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.65"/>
              <rect x="112" y="15" width="103" height="14" rx="3" fill="rgba(10,22,46,0.95)" stroke="#4FC3F7" stroke-width="1.3"/>
              <text x="119" y="25" fill="#4FC3F7" font-size="7.5" font-weight="bold" font-family="sans-serif">★ Major skill update pushed</text>
            </svg>
          </div>

          <!-- Card 2: MQLs weekly -->
          <div style="background: #243156; border: 1px solid #2E4070; border-radius: 4px; padding: 12px 14px 10px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
              <div>
                <p style="font-size: 12px; font-weight: 700; color: #fff;">MQLs per Week</p>
                <p style="font-size: 9px; color: #8DA5C4; margin-top: 2px;">Target: 10 &nbsp;·&nbsp; Marketing</p>
              </div>
              <div style="text-align: center; border-radius: 3px; padding: 4px 8px 3px; min-width: 56px; border: 1.5px solid #02C39A; background: #0A3020; flex-shrink:0; margin-left:6px;">
                <div style="font-size: 15px; font-weight: 700; color: #02C39A; line-height: 1.1;">12</div>
                <div style="font-size: 7px; color: #02C39A; margin-top: 1px;">this wk ✓</div>
              </div>
            </div>
            <!-- MQL SVG chart -->
            <svg viewBox="0 0 260 125" style="width:100%;display:block;overflow:visible;" xmlns="http://www.w3.org/2000/svg">
              <!-- Legend -->
              <line x1="28" y1="6" x2="46" y2="6" stroke="#FF6B35" stroke-width="1.8" stroke-dasharray="4,3"/>
              <text x="49" y="9" fill="#AABBD0" font-size="7.5" font-family="sans-serif">Target</text>
              <line x1="88" y1="6" x2="106" y2="6" stroke="#4FC3F7" stroke-width="2.2"/>
              <text x="109" y="9" fill="#AABBD0" font-size="7.5" font-family="sans-serif">Actual</text>
              <!-- Grid lines y=0,2,4,6,8,10,12,14 → svg 96,84,73,61,49,37,26,14 -->
              <line x1="28" y1="96" x2="252" y2="96" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="84" x2="252" y2="84" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="73" x2="252" y2="73" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="61" x2="252" y2="61" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="49" x2="252" y2="49" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="37" x2="252" y2="37" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="26" x2="252" y2="26" stroke="#2E4070" stroke-width="0.7"/>
              <!-- Y labels -->
              <text x="23" y="99" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">0</text>
              <text x="23" y="76" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">4</text>
              <text x="23" y="52" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">8</text>
              <text x="23" y="29" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">12</text>
              <!-- Target line (10 → svg 37) -->
              <line x1="28" y1="37" x2="252" y2="37" stroke="#FF6B35" stroke-width="2" stroke-dasharray="5,4"/>
              <!-- Area fill: 7→55, 8→49, 5→67, 6→61, 12→26 -->
              <polygon points="28,55 84,49 140,67 196,61 252,26 252,96 28,96" fill="#4FC3F710"/>
              <!-- Actual line -->
              <polyline points="28,55 84,49 140,67 196,61 252,26" fill="none" stroke="#4FC3F7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <!-- Data points -->
              <circle cx="28"  cy="55" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="84"  cy="49" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="140" cy="67" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="196" cy="61" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="252" cy="26" r="3.5" fill="#02C39A" stroke="#243156" stroke-width="1.5"/>
              <!-- X-axis labels -->
              <text x="28"  y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 6</text>
              <text x="84"  y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 13</text>
              <text x="140" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 20</text>
              <text x="196" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 27</text>
              <text x="252" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">May 4</text>
              <!-- Callout: LinkedIn spike at (252,26) -->
              <line x1="252" y1="26" x2="170" y2="23" stroke="#02C39A" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.65"/>
              <rect x="68" y="15" width="100" height="14" rx="3" fill="rgba(10,22,46,0.95)" stroke="#02C39A" stroke-width="1.3"/>
              <text x="75" y="25" fill="#02C39A" font-size="7.5" font-weight="bold" font-family="sans-serif">♦ LinkedIn post spike</text>
            </svg>
          </div>

          <!-- Card 3: MQLs cumulative -->
          <div style="background: #243156; border: 1px solid #2E4070; border-radius: 4px; padding: 12px 14px 10px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
              <div>
                <p style="font-size: 12px; font-weight: 700; color: #fff;">MQLs — Cumulative Q2</p>
                <p style="font-size: 9px; color: #8DA5C4; margin-top: 2px;">Running total vs. cumulative target &nbsp;·&nbsp; Marketing</p>
              </div>
              <div style="text-align: center; border-radius: 3px; padding: 4px 8px 3px; min-width: 56px; border: 1.5px solid #FFB347; background: #3A2010; flex-shrink:0; margin-left:6px;">
                <div style="font-size: 15px; font-weight: 700; color: #FFB347; line-height: 1.1;">38</div>
                <div style="font-size: 7px; color: #FFB347; margin-top: 1px;">−12 vs target</div>
              </div>
            </div>
            <!-- Cumulative SVG chart (13 week x-axis, 5 actuals) -->
