---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="OKR Tracker — Maxq Analytics">
  <SiteNav />

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-ink text-cream">
    <div class="max-w-5xl mx-auto">
      <a href="/#add-ons" class="inline-flex items-center gap-2 font-mono text-xs text-white/40 hover:text-white/70 transition-colors mb-8">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        All add-ons
      </a>
      <div class="flex items-center gap-2 mb-6">
        <span class="font-mono text-[10px] font-medium text-brand-300 bg-brand-600/10 border border-brand-600/20 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
        <span class="font-mono text-[10px] font-medium text-violet-400 bg-violet-400/10 border border-violet-400/20 px-2 py-0.5 rounded-full uppercase tracking-wider">Report</span>
      </div>
      <h1 class="font-black mb-6 leading-none" style="font-size: clamp(40px, 6vw, 72px); letter-spacing: -0.04em">OKR Tracker</h1>
      <p class="text-xl text-cream/55 max-w-2xl leading-relaxed mb-10">A bespoke report template that standardises how your team sets, tracks, and reviews OKRs each week — with live metrics, progress charts, and annotated context all in one place.</p>
      <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-cream text-ink font-semibold px-8 py-3.5 rounded-full hover:bg-white transition-colors text-sm">
        Set up your first OKR cycle
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- What it does -->
  <section class="py-24 px-6 bg-cream">
    <div class="max-w-5xl mx-auto">
      <div class="md:flex items-start gap-16">
        <div class="shrink-0 mb-8 md:mb-0">
          <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">What it does</div>
          <h2 class="text-3xl font-bold text-ink" style="letter-spacing: -0.02em; max-width: 280px">OKR reviews that actually tell the story.</h2>
        </div>
        <div class="space-y-4 text-ink/60 leading-relaxed max-w-xl pt-1">
          <p>Most OKR tracking lives in a spreadsheet that nobody opens between quarters. The OKR Tracker is a structured weekly report template that pulls actual metric performance into a consistent format your team reviews together every week.</p>
          <p>Each key result gets its own chart: target vs. actual, week by week, with annotations for context — a spike caused by a LinkedIn post, a dip caused by an outage. The narrative is built in, not reconstructed after the fact.</p>
          <p>The data source is flexible depending on the level of automation your team wants. At the fully automated end, the report connects directly to your Semantic Nexus and refreshes without any manual input. If you're not there yet, it can be populated from a spreadsheet instead — giving you the same structured format while you build toward a more automated setup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mockup -->
  <section class="py-24 px-6 bg-warm">
    <div class="max-w-5xl mx-auto">
      <div class="mb-10">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Example output</div>
        <h2 class="text-3xl font-bold text-ink mb-2" style="letter-spacing: -0.02em">What a weekly check-in looks like.</h2>
        <p class="text-ink/50 text-sm">Q2 2026 · Week 5 of 13 · Three key results tracked across operations and marketing.</p>
      </div>

      <!-- Dashboard mockup -->
      <div class="overflow-x-auto rounded-2xl">
      <div class="rounded-2xl overflow-hidden shadow-sm border border-white/10" style="background: #1A2744; padding: 28px 32px 24px; min-width: 700px;">

        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
          <div>
            <p style="font-size: 18px; font-weight: 700; color: #fff; letter-spacing: -0.2px;">Q2 2026 OKR Weekly Check-in</p>
            <p style="font-size: 11px; color: #8DA5C4; margin-top: 4px;">Week of May 4, 2026 &nbsp;·&nbsp; 5 of 13 weeks tracked</p>
          </div>
          <p style="font-size: 11px; color: #8DA5C4; padding-top: 2px;">Example Co.</p>
        </div>
        <div style="height: 1px; background: #2E4070; margin: 10px 0 16px;"></div>

        <!-- Three cards -->
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px;">

          <!-- Card 1: CSAT -->
          <div style="background: #243156; border: 1px solid #2E4070; border-radius: 4px; padding: 14px 16px 12px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <p style="font-size: 13px; font-weight: 700; color: #fff;">Implementation CSAT</p>
                <p style="font-size: 9.5px; color: #8DA5C4; margin-top: 3px;">Target: ≥ 9.0 &nbsp;·&nbsp; Operations</p>
              </div>
              <div style="text-align: center; border-radius: 3px; padding: 5px 10px 4px; min-width: 62px; border: 1.5px solid #4FC3F7; background: #1A3A5C;">
                <div style="font-size: 17px; font-weight: 700; color: #4FC3F7; line-height: 1.1;">7.3</div>
                <div style="font-size: 7.5px; color: #8DA5C4; margin-top: 2px;">this wk</div>
              </div>
            </div>
            <div style="position: relative; height: 180px;">
              <canvas id="okrCsatChart"></canvas>
            </div>
          </div>

          <!-- Card 2: MQLs weekly -->
          <div style="background: #243156; border: 1px solid #2E4070; border-radius: 4px; padding: 14px 16px 12px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <p style="font-size: 13px; font-weight: 700; color: #fff;">MQLs per Week</p>
                <p style="font-size: 9.5px; color: #8DA5C4; margin-top: 3px;">Target: 10 &nbsp;·&nbsp; Marketing</p>
              </div>
              <div style="text-align: center; border-radius: 3px; padding: 5px 10px 4px; min-width: 62px; border: 1.5px solid #02C39A; background: #0A3020;">
                <div style="font-size: 17px; font-weight: 700; color: #02C39A; line-height: 1.1;">12</div>
                <div style="font-size: 7.5px; color: #02C39A; margin-top: 2px;">this wk ✓</div>
              </div>
            </div>
            <div style="position: relative; height: 180px;">
              <canvas id="okrMqlChart"></canvas>
            </div>
          </div>

          <!-- Card 3: MQLs cumulative -->
          <div style="background: #243156; border: 1px solid #2E4070; border-radius: 4px; padding: 14px 16px 12px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <p style="font-size: 13px; font-weight: 700; color: #fff;">MQLs — Cumulative Q2</p>
                <p style="font-size: 9.5px; color: #8DA5C4; margin-top: 3px;">Running total vs. cumulative target &nbsp;·&nbsp; Marketing</p>
              </div>
              <div style="text-align: center; border-radius: 3px; padding: 5px 10px 4px; min-width: 62px; border: 1.5px solid #FFB347; background: #3A2010;">
                <div style="font-size: 17px; font-weight: 700; color: #FFB347; line-height: 1.1;">38</div>
                <div style="font-size: 7.5px; color: #FFB347; margin-top: 2px;">−12 vs target</div>
              </div>
            </div>
            <div style="position: relative; height: 180px;">
              <canvas id="okrCumulChart"></canvas>
            </div>
          </div>

        </div>
      </div>
      </div>

      <p class="text-xs text-ink/40 mt-4 text-center font-mono">Illustrative output — metrics and key results are configured per client context.</p>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="py-24 px-6 bg-ink text-cream">
    <div class="max-w-5xl mx-auto">
      <div class="mb-14">
        <div class="text-xs font-mono font-medium text-violet-400 uppercase tracking-widest mb-4">Roadmap</div>
        <h2 class="text-3xl font-bold text-cream" style="letter-spacing: -0.02em">Where we're taking it.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-7 h-7 rounded-full flex items-center justify-center font-black text-sm" style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.5)">1</div>
            <span class="font-mono text-[10px] text-white/30 uppercase tracking-wider">In progress</span>
          </div>
          <h3 class="font-bold text-cream text-lg mb-3">Active development at Freeday</h3>
          <p class="text-white/50 text-sm leading-relaxed">We are actively developing the OKR Tracker with Freeday to support their weekly team check-in for their implementation funnel. The report tracks key metrics that directly reflect the reliability and performance of their implementation process — giving the team a consistent, data-backed view every week and surfacing blockers before they compound.</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-7 h-7 rounded-full flex items-center justify-center font-black text-sm" style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.5)">2</div>
            <span class="font-mono text-[10px] text-white/30 uppercase tracking-wider">Coming next</span>
          </div>
          <h3 class="font-bold text-cream text-lg mb-3">Plug-and-play template</h3>
          <p class="text-white/50 text-sm leading-relaxed">The goal is to make the OKR Tracker accessible without a weeks-long implementation. We're working towards a template-based setup that lets clients define their key results, connect their data source, and have a working weekly check-in report running within a few hours — rather than a bespoke build from scratch each time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-24 px-6 bg-cream">
    <div class="max-w-5xl mx-auto">
      <div class="md:flex items-start gap-16">
        <div class="shrink-0 mb-8 md:mb-0">
          <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Pricing</div>
          <h2 class="text-3xl font-bold text-ink" style="letter-spacing: -0.02em; max-width: 260px">Implementation only.</h2>
        </div>
        <div class="max-w-xl pt-1">
          <p class="text-ink/60 leading-relaxed mb-5">The OKR Tracker is a report template — not a standalone product. Every implementation is built around your specific key results, your data model, and the metrics that actually matter to your team. That level of bespoke configuration makes it impractical to charge a recurring or usage-based fee.</p>
          <p class="text-ink/60 leading-relaxed mb-8">We charge for the implementation work only: scoping which key results to track, wiring them to your live data in Semantic Nexus, and building the report in a format your team will actually use in their weekly rhythm.</p>
          <div class="bg-warm border border-ink/10 rounded-xl p-6 flex flex-col sm:flex-row sm:items-center gap-5">
            <div class="flex-1">
              <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-1">Pricing model</p>
              <p class="font-black text-ink text-xl" style="letter-spacing: -0.02em">Implementation fee only</p>
              <p class="text-ink/50 text-sm mt-1">No licence fee — you own the template once it's built.</p>
            </div>
            <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="shrink-0 inline-flex items-center gap-2 bg-ink text-cream font-semibold px-6 py-3 rounded-full hover:bg-ink/80 transition-colors text-sm">
              Get a scope
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-24 px-6 bg-warm">
    <div class="max-w-5xl mx-auto">
      <div class="mb-14">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Built by</div>
        <h2 class="text-3xl font-bold text-ink" style="letter-spacing: -0.02em">The person behind the OKR Tracker.</h2>
      </div>
      <div class="max-w-sm">
        <div class="bg-cream rounded-2xl p-8 border border-ink/8">
          <img src="/team/philip.png" alt="Philip Boontje" class="w-16 h-16 rounded-full object-cover mb-6 ring-2 ring-ink/8" />
          <h3 class="font-bold text-ink text-lg mb-1">Philip Boontje</h3>
          <p class="font-mono text-xs text-brand-600 uppercase tracking-wider mb-1">Product Owner · Maintainer & developer</p>
          <p class="font-mono text-[10px] text-ink/35 uppercase tracking-wider mb-4">Founder · Maxq Analytics</p>
          <p class="text-ink/60 text-sm leading-relaxed">Philip is the product owner and developer on the OKR Tracker. He designs the report structure, wires it to client data in Semantic Nexus, and adapts each implementation to the specific key results and team rhythm of the client.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 bg-ink text-cream text-center">
    <div class="max-w-2xl mx-auto">
      <div class="text-xs font-mono font-medium text-brand-300 uppercase tracking-widest mb-6">Get started</div>
      <h2 class="text-4xl font-black mb-4" style="letter-spacing: -0.03em">OKR reviews that <span class="text-brand-300">tell the whole story.</span></h2>
      <p class="text-cream/50 mb-10 leading-relaxed">We'll map your key results, wire them to your live data, and build the first weekly check-in together — so your team walks into the next review with a report that's already ready.</p>
      <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-cream text-ink font-semibold px-8 py-3.5 rounded-full hover:bg-white transition-colors text-sm">
        Set up your first OKR cycle
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <SiteFooter />
</Layout>

<script>
// Load Chart.js from CDN then render
(function() {
  const script = document.createElement('script');
  script.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js';
  script.onload = initCharts;
  document.head.appendChild(script);

  function roundedRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y); ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  function drawCallout(ctx, px, py, item) {
    const { lines, color, side } = item;
    const pad = { x: 7, y: 5 }, fs = 8, lh = 12, gap = 16, r = 4;
    ctx.save();
    ctx.font = `bold ${fs}px 'Segoe UI',sans-serif`;
    const maxW = Math.max(...lines.map(l => ctx.measureText(l).width));
    const bw = maxW + pad.x * 2, bh = lines.length * lh + pad.y * 2;
    let bx, by, lx1, ly1, lx2, ly2;
    if (side === 'above') {
      bx = px - bw / 2; by = py - gap - bh;
      lx1 = px; ly1 = py - 7; lx2 = px; ly2 = by + bh;
    } else if (side === 'above-left') {
      bx = px - bw - 6; by = py - gap - bh;
      lx1 = px; ly1 = py - 7; lx2 = bx + bw; ly2 = by + bh;
    } else if (side === 'left') {
      bx = px - gap - bw; by = py - bh / 2;
      lx1 = px - 7; ly1 = py; lx2 = bx + bw; ly2 = py;
    }
    ctx.strokeStyle = color; ctx.lineWidth = 1.5;
    ctx.globalAlpha = 0.6; ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(lx1, ly1); ctx.lineTo(lx2, ly2); ctx.stroke();
    ctx.setLineDash([]); ctx.globalAlpha = 1;
    roundedRect(ctx, bx, by, bw, bh, r);
    ctx.fillStyle = 'rgba(10, 22, 46, 0.96)'; ctx.fill();
    roundedRect(ctx, bx, by, bw, bh, r);
    ctx.strokeStyle = color; ctx.lineWidth = 1.5; ctx.stroke();
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    lines.forEach((line, i) => {
      ctx.font = `bold ${fs}px 'Segoe UI',sans-serif`;
      ctx.fillStyle = i === 0 ? color : '#DDEEFF';
      ctx.fillText(line, bx + pad.x, by + pad.y + i * lh);
    });
    ctx.restore();
  }

  function initCharts() {
    const calloutPlugin = {
      id: 'callouts',
      afterDraw(chart) {
        const items = chart.config.options.callouts;
        if (!items || !items.length) return;
        const xs = chart.scales.x, ys = chart.scales.y;
        items.forEach(item => {
          drawCallout(chart.ctx, xs.getPixelForValue(item.xi), ys.getPixelForValue(item.y), item);
        });
      }
    };
    Chart.register(calloutPlugin);

    const weeks13 = ["Apr 6","Apr 13","Apr 20","Apr 27","May 4","May 11","May 18","May 25","Jun 1","Jun 8","Jun 15","Jun 22","Jun 29"];
    const weeks5  = weeks13.slice(0, 5);

    function makeDS(label, data, color, dashed, spanGaps = false) {
      return {
        label, data, spanGaps,
        borderColor: color, backgroundColor: color,
        borderWidth: dashed ? 2 : 2.8,
        borderDash: dashed ? [5, 4] : [],
        pointBackgroundColor: data.map(v => v === null ? 'transparent' : color),
        pointBorderColor: data.map(v => v === null ? 'transparent' : '#243156'),
        pointBorderWidth: 1.5,
        pointRadius: data.map(v => v === null ? 0 : 5),
        pointHoverRadius: data.map(v => v === null ? 0 : 7),
        tension: 0.1,
        fill: (!dashed && !spanGaps) ? { target: 'origin', above: color + '12' } : false,
      };
    }

    function baseOpts(yMax, yStep) {
      return {
        responsive: true, maintainAspectRatio: false,
        animation: { duration: 700 },
        layout: { padding: { top: 6, right: 18, bottom: 4, left: 4 } },
        plugins: {
          legend: {
            position: 'top', align: 'start',
            labels: { color: '#AABBD0', font: { size: 9 }, boxWidth: 22, boxHeight: 2, padding: 8, usePointStyle: false }
          },
          tooltip: {
            backgroundColor: '#0E1C36', borderColor: '#2E4070', borderWidth: 1,
            titleColor: '#AABBD0', bodyColor: '#FFFFFF', padding: 8,
            callbacks: { label: ctx => ctx.parsed.y === null ? '' : ` ${ctx.dataset.label}: ${ctx.parsed.y}` }
          },
        },
        scales: {
          x: {
            grid: { display: false }, border: { display: false },
            ticks: { color: '#8DA5C4', font: { size: 9 }, maxRotation: 0 }
          },
          y: {
            min: 0, max: yMax, border: { display: false },
            grid: { color: '#2E4070', lineWidth: 0.8 },
            ticks: { color: '#8DA5C4', font: { size: 9 }, stepSize: yStep, maxTicksLimit: 8 }
          }
        }
      };
    }

    // CSAT chart
    const csatOpts = baseOpts(11, 2);
    csatOpts.callouts = [
      { xi: 3, y: 4.6, side: 'above',      color: '#FFB347', lines: ['⚠ Outage — 5 hrs (Tue)'] },
      { xi: 4, y: 7.3, side: 'above-left', color: '#4FC3F7', lines: ['★ Major skill update pushed'] },
    ];
    const csatActual = [5.5, 6.0, 5.8, 4.6, 7.3];
    const csatDS = makeDS('Actual', csatActual, '#4FC3F7', false);
    csatDS.pointBackgroundColor = csatActual.map(v => v >= 9 ? '#02C39A' : '#4FC3F7');
    csatDS.pointBorderColor = csatActual.map(() => '#243156');
    csatDS.segment = { borderColor: ctx => ctx.p1.parsed.y >= 9 ? '#02C39A' : '#4FC3F7' };
    new Chart(document.getElementById('okrCsatChart'), {
      type: 'line',
      data: { labels: weeks5, datasets: [makeDS('Target', [9,9,9,9,9], '#FF6B35', true), csatDS] },
      options: csatOpts,
    });

    // MQL weekly chart
    const mqlOpts = baseOpts(14, 2);
    mqlOpts.callouts = [{ xi: 4, y: 12, side: 'left', color: '#02C39A', lines: ['♦ LinkedIn post spike'] }];
    new Chart(document.getElementById('okrMqlChart'), {
      type: 'line',
      data: { labels: weeks5, datasets: [makeDS('Target', [10,10,10,10,10], '#FF6B35', true), makeDS('Actual', [7,8,5,6,12], '#4FC3F7', false)] },
      options: mqlOpts,
    });

    // MQL cumulative chart
    const cumulOpts = baseOpts(140, 20);
    cumulOpts.callouts = [{ xi: 4, y: 38, side: 'above-left', color: '#02C39A', lines: ['♦ LinkedIn spike (+12)', '38 total  ·  −12 vs target'] }];
    cumulOpts.scales.x.ticks.callback = function(val, i) { return [0,4,8,12].includes(i) ? this.getLabelForValue(val) : ''; };
    const mqlCumul = [7,15,20,26,38];
    new Chart(document.getElementById('okrCumulChart'), {
      type: 'line',
      data: {
        labels: weeks13,
        datasets: [
          makeDS('Cumul. Target', weeks13.map((_, i) => (i+1)*10), '#FF6B35', true, false),
          makeDS('Cumul. Actual', [...mqlCumul, ...Array(8).fill(null)], '#4FC3F7', false, false),
        ]
      },
      options: cumulOpts,
    });
  }
})();
</script>
