              <text x="49" y="9" fill="#AABBD0" font-size="7.5" font-family="sans-serif">Cumul. Target</text>
              <line x1="128" y1="6" x2="146" y2="6" stroke="#4FC3F7" stroke-width="2.2"/>
              <text x="149" y="9" fill="#AABBD0" font-size="7.5" font-family="sans-serif">Cumul. Actual</text>
              <!-- Grid lines at 0,20,40,60,80,100,120,140 → svg 96,84,73,61,49,37,26,14 -->
