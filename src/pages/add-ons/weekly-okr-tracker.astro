              <line x1="28" y1="84" x2="252" y2="84" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="73" x2="252" y2="73" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="61" x2="252" y2="61" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="49" x2="252" y2="49" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="37" x2="252" y2="37" stroke="#2E4070" stroke-width="0.7"/>
              <line x1="28" y1="26" x2="252" y2="26" stroke="#2E4070" stroke-width="0.7"/>
              <!-- Y labels -->
              <text x="23" y="99" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">0</text>
              <text x="23" y="52" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">60</text>
              <text x="23" y="17" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="end">120</text>
              <!-- Cumulative target: 13 weeks, x step=224/12=18.67 from 28
                   vals: 10→90, 20→84, 30→78, 40→73, 50→67, 60→61, 70→55, 80→49, 90→43, 100→37, 110→31, 120→26, 130→20
                   x:   28,   47,   65,   84,  103,  121,  140,  159,  177,  196,  215,  233,  252 -->
              <polyline points="28,90 47,84 65,78 84,73 103,67 121,61 140,55 159,49 177,43 196,37 215,31 233,26 252,20"
                fill="none" stroke="#FF6B35" stroke-width="1.8" stroke-dasharray="5,4" stroke-linecap="round"/>
              <!-- Target dots at each of 13 weeks -->
              <circle cx="28"  cy="90" r="2.5" fill="#FF6B35"/>
              <circle cx="47"  cy="84" r="2.5" fill="#FF6B35"/>
              <circle cx="65"  cy="78" r="2.5" fill="#FF6B35"/>
              <circle cx="84"  cy="73" r="2.5" fill="#FF6B35"/>
              <circle cx="103" cy="67" r="2.5" fill="#FF6B35"/>
              <circle cx="121" cy="61" r="2.5" fill="#FF6B35"/>
              <circle cx="140" cy="55" r="2.5" fill="#FF6B35"/>
              <circle cx="159" cy="49" r="2.5" fill="#FF6B35"/>
              <circle cx="177" cy="43" r="2.5" fill="#FF6B35"/>
              <circle cx="196" cy="37" r="2.5" fill="#FF6B35"/>
              <circle cx="215" cy="31" r="2.5" fill="#FF6B35"/>
              <circle cx="233" cy="26" r="2.5" fill="#FF6B35"/>
              <circle cx="252" cy="20" r="2.5" fill="#FF6B35"/>
              <!-- Cumulative actual: 5 weeks only
                   vals: 7→92, 15→87, 20→84, 26→81, 38→74
                   x:   28,   47,    65,   84,   103 -->
              <polygon points="28,92 47,87 65,84 84,81 103,74 103,96 28,96" fill="#4FC3F710"/>
              <polyline points="28,92 47,87 65,84 84,81 103,74" fill="none" stroke="#4FC3F7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="28"  cy="92" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="47"  cy="87" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="65"  cy="84" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="84"  cy="81" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <circle cx="103" cy="74" r="3.5" fill="#4FC3F7" stroke="#243156" stroke-width="1.5"/>
              <!-- X-axis labels (4 of 13) -->
              <text x="28"  y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Apr 6</text>
              <text x="103" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">May 4</text>
              <text x="177" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Jun 1</text>
              <text x="252" y="110" fill="#8DA5C4" font-size="7.5" font-family="sans-serif" text-anchor="middle">Jun 29</text>
              <!-- Callout: LinkedIn spike (+12) at last actual point (103,74) -->
              <line x1="103" y1="74" x2="103" y2="61" stroke="#02C39A" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.65"/>
              <rect x="2" y="43" width="100" height="26" rx="3" fill="rgba(10,22,46,0.95)" stroke="#02C39A" stroke-width="1.3"/>
              <text x="9" y="55" fill="#02C39A" font-size="7.5" font-weight="bold" font-family="sans-serif">♦ LinkedIn spike (+12)</text>
              <text x="9" y="66" fill="#DDEEFF" font-size="7" font-family="sans-serif">38 total · −12 vs target</text>
            </svg>
