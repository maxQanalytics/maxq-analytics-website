---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="Add-ons — Maxq Analytics">
  <SiteNav />

  <section id="add-ons" class="pt-32 pb-24 px-6 bg-warm min-h-screen">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Add-ons</div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Go further with <span class="text-brand-600">your data.</span></h1>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">Optional modules that plug directly into the Semantic Nexus. Each one solves a specific high-value problem — built on top of the same single source of truth.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 md:max-w-3xl md:mx-auto">

        <!-- Analytics Assistant — Ask -->
        <a href="/add-ons/analytics-assistant" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.9 9.9 0 01-4-.8L3 20l1.3-3.9A7.6 7.6 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-sky-700 bg-sky-50 border border-sky-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Ask</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Conversational analytics</p>
          <h3 class="text-base font-bold text-ink mb-2">Analytics Assistant</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">An AI analyst your whole team can talk to. Ask data questions in Slack, a web chat, or straight from Claude and get accurate, chart-backed answers in seconds — every one grounded in a governed context layer built on your Semantic Nexus.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>

        <!-- Data Quality Guardian — Protect -->
        <a href="/add-ons/quality-guardian" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Protect</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Data integrity</p>
          <h3 class="text-base font-bold text-ink mb-2">Quality Guardian</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">An AI automation that continuously scans your data for anomalies and surfaces them to the relevant data entry test owners with proposed corrections. Issues get to the right person with enough context to act — before a bad number reaches a report or a decision.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>




      </div>

      <!-- Alternative design: the partner page's block format (label, wordmark row, text, link pinned to the bottom) -->
      <div class="mt-24 pt-16 border-t border-ink/10">
        <p class="text-center text-[10px] font-mono text-ink/35 uppercase tracking-widest mb-12">Alternative design · partner page format</p>
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <h1 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Add-ons</h1>
            <p class="text-lg text-ink/55 max-w-2xl mx-auto">Optional modules that plug directly into the Semantic Nexus. Each one solves a specific high-value problem, built on top of the same single source of truth.</p>
          </div>
          <div class="grid md:grid-cols-2 gap-4 md:max-w-3xl md:mx-auto">

            <!-- Analytics Assistant — Ask -->
            <div class="bg-cream rounded-xl p-8 flex flex-col border border-ink/10">
              <div class="text-brand-600 text-xs font-mono font-semibold uppercase tracking-widest mb-6">Ask</div>
              <div class="flex flex-row items-center gap-3 mb-6 text-ink/75">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.9 9.9 0 01-4-.8L3 20l1.3-3.9A7.6 7.6 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <span class="text-xl font-bold" style="letter-spacing: -0.01em">Analytics Assistant</span>
              </div>
              <p class="text-ink/60 text-sm leading-relaxed">An AI analyst your whole team can talk to. Ask data questions in Slack, a web chat, or straight from Claude and get accurate, chart-backed answers in seconds, every one grounded in a governed context layer built on your Semantic Nexus.</p>
              <a href="/add-ons/analytics-assistant" class="mt-auto pt-5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Explore Analytics Assistant →</a>
            </div>

            <!-- Quality Guardian — Protect -->
            <div class="bg-cream rounded-xl p-8 flex flex-col border border-ink/10">
              <div class="text-brand-600 text-xs font-mono font-semibold uppercase tracking-widest mb-6">Protect</div>
              <div class="flex flex-row items-center gap-3 mb-6 text-ink/75">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-xl font-bold" style="letter-spacing: -0.01em">Quality Guardian</span>
              </div>
              <p class="text-ink/60 text-sm leading-relaxed">An AI automation that continuously scans your data for anomalies and surfaces them to the relevant data entry test owners with proposed corrections. Issues get to the right person with enough context to act, before a bad number reaches a report or a decision.</p>
              <a href="/add-ons/quality-guardian" class="mt-auto pt-5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Explore Quality Guardian →</a>
            </div>

          </div>
        </div>
      </div>

      <p class="text-center text-sm text-ink/40 mt-10">Need something specific? We build bespoke add-ons for custom workflows. <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="text-brand-600 hover:text-ink transition-colors font-medium">Let's talk →</a></p>
    </div>
  </section>

  <SiteFooter />
</Layout>
