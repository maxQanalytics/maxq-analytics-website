---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="Add-ons — Maxq Analytics">
  <SiteNav />

  <section id="add-ons" class="pt-32 pb-24 px-6 bg-warm min-h-screen">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Add-ons</div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Go further with <span class="text-brand-600">your data.</span></h1>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">Optional modules that plug directly into the Semantic Nexus. Each one solves a specific high-value problem — built on top of the same single source of truth.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-4">

        <!-- Upsell Calculator — Grow -->
        <a href="/add-ons/upsell-calculator" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Grow</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Revenue intelligence</p>
          <h3 class="text-base font-bold text-ink mb-2">Upsell Calculator</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">A spreadsheet calculator linked directly to the Semantic Nexus that runs pricing-impact calculations based on historic client usage metrics. Model different pricing scenarios against real usage data — and walk into every upsell conversation with numbers that are already grounded in what the client actually does.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>

        <!-- Data Quality Guardian — Protect -->
        <a href="/add-ons/quality-guardian" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Protect</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Data integrity</p>
          <h3 class="text-base font-bold text-ink mb-2">Quality Guardian</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">An AI automation that continuously scans your data for anomalies and surfaces them to the relevant data entry test owners with proposed corrections. Issues get to the right person with enough context to act — before a bad number reaches a report or a decision.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>

        <!-- Firefighter — Protect -->
        <a href="/add-ons/firefighter" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Protect</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Risk intelligence</p>
          <h3 class="text-base font-bold text-ink mb-2">Firefighter</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">An AI agent that continuously monitors client behaviour patterns and surfaces high-risk signals before they escalate. When risk is detected, Firefighter proposes concrete remediation actions — giving your team a clear playbook with prioritised next steps instead of a vague warning to act on.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>

        <!-- Weekly OKR Tracker — Report -->
        <a href="/add-ons/weekly-okr-tracker" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="6" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-violet-700 bg-violet-50 border border-violet-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Report</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Goal management</p>
          <h3 class="text-base font-bold text-ink mb-2">OKR Tracker</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">A structured OKR template that standardises how clients set, track, and review objectives across teams. Weekly check-ins surface progress and blockers early — with future iterations adding automations, escalation workflows, and call-to-action triggers wired directly into your live metrics.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>

        <!-- Metricsrouter — Report -->
        <a href="/add-ons/metricsrouter" class="group bg-cream rounded-xl p-7 flex flex-col border border-ink/10 border-t-[3px] border-t-brand-600 hover:shadow-md transition-all duration-200">
          <div class="flex items-start justify-between mb-5">
            <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[10px] font-medium text-violet-700 bg-violet-50 border border-violet-200 px-2 py-0.5 rounded-full uppercase tracking-wider">Report</span>
              <span class="font-mono text-[10px] font-medium text-brand-600 bg-brand-50 border border-brand-100 px-2 py-0.5 rounded-full uppercase tracking-wider">Add-on</span>
            </div>
          </div>
          <p class="font-mono text-xs text-ink/40 uppercase tracking-wider mb-2">Open metrics exchange</p>
          <h3 class="text-base font-bold text-ink mb-2">Metricsrouter</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-5">Maxq's open metrics exchange — an inter-entity protocol that enables organisations to share standardised performance metrics across company boundaries. Built for investor reporting, board-level benchmarking, and cross-portfolio analytics where consistent metric definitions matter most.</p>
          <span class="mt-auto text-xs font-semibold text-brand-600 group-hover:text-brand-700 transition-colors">Explore add-on →</span>
        </a>

      </div>

      <p class="text-center text-sm text-ink/40 mt-10">Need something specific? We build bespoke add-ons for custom workflows. <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="text-brand-600 hover:text-ink transition-colors font-medium">Let's talk →</a></p>
    </div>
  </section>

  <SiteFooter />
</Layout>
