  <!-- Screenshot lightbox -->
  <div id="qgLightbox" class="fixed inset-0 z-[1000] bg-ink/85 backdrop-blur-sm overflow-y-auto" hidden>
    <button id="qgLightboxClose" aria-label="Close" class="fixed top-4 right-4 z-10 w-11 h-11 rounded-full bg-cream text-ink flex items-center justify-center shadow-lg hover:bg-white">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="min-h-full flex items-start justify-center px-4 py-10 md:px-10 md:py-14">
      <figure class="m-0 w-full" style="max-width: 1600px">
        <img id="qgLightboxImg" src="" alt="" class="w-full h-auto block rounded-lg shadow-2xl bg-white" />
        <figcaption id="qgLightboxCap" class="text-cream/80 text-sm mt-4 text-center font-mono"></figcaption>
      </figure>
    </div>
  </div>
  <script is:inline>
    (function () {
      var box = document.getElementById('qgLightbox');
      var img = document.getElementById('qgLightboxImg');
      var cap = document.getElementById('qgLightboxCap');
      var closeBtn = document.getElementById('qgLightboxClose');
      if (!box || !img) return;
      function open(src, alt) {
        img.src = src; img.alt = alt || ''; cap.textContent = alt || '';
        box.hidden = false; box.scrollTop = 0;
        document.documentElement.style.overflow = 'hidden';
      }
      function close() {
        box.hidden = true; img.src = '';
        document.documentElement.style.overflow = '';
      }
      document.querySelectorAll('.qg-shot').forEach(function (frame) {
        frame.addEventListener('click', function () {
          var el = frame.querySelector('img');
          if (el) open(el.getAttribute('src'), el.getAttribute('alt'));
        });
      });
      closeBtn.addEventListener('click', close);
      box.addEventListener('click', function (e) { if (e.target === box || e.target.tagName === 'FIGURE' || e.target.classList.contains('min-h-full')) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) close(); });
    })();
  </script>

