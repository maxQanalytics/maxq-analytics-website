---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Calendly Modal -->
  <div id="calendlyModal" style="position:fixed;inset:0;background:rgba(10,10,15,0.6);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:1000;display:flex;align-items:center;justify-content:center;padding:24px;opacity:0;visibility:hidden;transition:opacity 0.3s ease,visibility 0.3s ease;">
    <div id="calendlyContainer" style="background:#f5f3f0;border-radius:16px;width:100%;max-width:680px;max-height:90vh;overflow:hidden;transform:translateY(20px) scale(0.97);transition:transform 0.35s cubic-bezier(0.16,1,0.3,1);box-shadow:0 24px 80px rgba(0,0,0,0.25);">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid rgba(10,10,15,0.08);">
        <div>
          <div style="font-size:16px;font-weight:700;letter-spacing:-0.01em;color:#0a0a0f">Schedule a call with Philip</div>
          <div style="font-family:'DM Mono',monospace;font-size:11px;color:#6b6560;text-transform:uppercase;letter-spacing:0.04em;margin-top:2px">30 min · no pitch deck · just data talk</div>
        </div>
        <button id="calendlyClose" aria-label="Close" style="width:36px;height:36px;border-radius:50%;border:1px solid rgba(10,10,15,0.12);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.2s">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0a0a0f" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div style="height:640px;overflow:hidden;">
        <iframe id="calendlyFrame" src="about:blank" title="Schedule a call with Philip Boontje" loading="lazy" style="width:100%;height:100%;border:none;"></iframe>
      </div>
    </div>
  </div>

  <!-- Nav -->
  <nav class="fixed top-0 w-full z-50 bg-ink/95 backdrop-blur border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center">
          <img src="/maxq-logo.png" alt="Maxq Analytics" class="h-9 w-9 rounded-lg object-cover" />
        </a>
        <div class="hidden md:flex items-center gap-8 text-sm text-white/55 font-medium">
          <a href="#impact" class="hover:text-white transition-colors">Impact</a>
          <a href="#product-items" class="hover:text-white transition-colors">Features</a>
          <a href="#frameworks" class="hover:text-white transition-colors">Frameworks</a>
          <a href="#case-studies" class="hover:text-white transition-colors">Case Studies</a>
          <a href="#pricing" class="hover:text-white transition-colors">Pricing</a>
        </div>
      </div>
      <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="hidden md:inline-flex bg-white text-ink px-5 py-2 rounded-full text-sm font-semibold hover:bg-cream transition-colors">
        Talk to us
      </a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-ink text-cream relative overflow-hidden">
    <div class="hero-grid-lines" aria-hidden="true">
      <div class="hero-line-v" style="left: 20%"></div>
      <div class="hero-line-v" style="left: 40%"></div>
      <div class="hero-line-v" style="left: 60%"></div>
      <div class="hero-line-v" style="left: 80%"></div>
      <div class="hero-line-h" style="top: 25%"></div>
      <div class="hero-line-h" style="top: 50%"></div>
      <div class="hero-line-h" style="top: 75%"></div>
    </div>
    <div class="max-w-5xl mx-auto text-center relative">
      <h1 class="font-black mb-7 leading-none mx-auto" style="font-size: clamp(42px, 7.5vw, 88px); letter-spacing: -0.04em; max-width: 820px">
        Everyone has<br>different numbers.<br><span class="text-brand-300">That ends here.</span>
      </h1>
      <p class="text-lg md:text-xl text-cream/55 max-w-xl mx-auto mb-10 leading-relaxed">
        One source of truth for your entire business, from raw data to boardroom KPIs. So every team works from the same numbers, every time.
      </p>
      <div class="flex gap-3 justify-center flex-wrap mb-14">
        <a href="#impact" class="inline-flex items-center gap-2 text-cream font-semibold px-8 py-3.5 rounded-full transition-colors text-sm" style="border: 1px solid rgba(255,255,255,0.20)" onmouseover="this.style.borderColor='rgba(255,255,255,0.50)';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.20)';this.style.background=''">
          See how it works
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
        </a>
        <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-cream text-ink font-semibold px-8 py-3.5 rounded-full hover:bg-white transition-colors text-sm">
          Schedule a Call
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <!-- Dashboard mockup -->
      <div class="hero-visual">
        <div class="hero-dashboard">
          <div class="dash-topbar">
            <span class="dash-dot" style="background: rgba(96,165,250,0.5)"></span>
            <span class="dash-dot"></span>
            <span class="dash-dot"></span>
            <span class="dash-tab dash-tab-active">Overview</span>
            <span class="dash-tab">Revenue</span>
            <span class="dash-tab">Pipeline</span>
          </div>
          <div class="dash-grid">
            <div class="dash-metric">
              <div class="dash-metric-label">Monthly Revenue</div>
              <div class="dash-metric-value">&euro;847K</div>
              <div class="dash-metric-change">+12.4% vs last month</div>
            </div>
            <div class="dash-metric">
              <div class="dash-metric-label">Gross Margin</div>
              <div class="dash-metric-value">68.2%</div>
              <div class="dash-metric-change">+3.1pp vs target</div>
            </div>
            <div class="dash-metric">
              <div class="dash-metric-label">Active Contracts</div>
              <div class="dash-metric-value">142</div>
              <div class="dash-metric-change">+14 vs. last month</div>
            </div>
          </div>
          <div class="dash-chart">
            <div class="dash-bar" style="height: 35%"></div>
            <div class="dash-bar" style="height: 42%"></div>
            <div class="dash-bar" style="height: 38%"></div>
            <div class="dash-bar" style="height: 55%"></div>
            <div class="dash-bar" style="height: 48%"></div>
            <div class="dash-bar" style="height: 62%"></div>
            <div class="dash-bar" style="height: 58%"></div>
            <div class="dash-bar" style="height: 71%"></div>
            <div class="dash-bar" style="height: 65%"></div>
            <div class="dash-bar" style="height: 78%"></div>
            <div class="dash-bar" style="height: 72%"></div>
            <div class="dash-bar" style="height: 85%"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 px-6 bg-ink text-cream">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 text-center">
        {[
          { value: '8', label: 'Active clients' },
          { value: '460+', label: 'FTE across clients' },
          { value: '€63M+', label: 'Combined annual revenue' },
          { value: '25k+', label: 'Analytics API requests / day' },
        ].map(stat => (
          <div class="flex flex-col gap-2">
            <span class="text-4xl md:text-5xl font-black text-cream tracking-tight" style="letter-spacing: -0.03em">{stat.value}</span>
            <span class="text-xs font-mono text-cream/40 leading-snug uppercase tracking-wider">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Logo Carousel -->
  <section class="py-12 bg-cream overflow-hidden">
    <p class="text-center text-xs font-mono font-medium text-ink/40 uppercase tracking-widest mb-8">Trusted by</p>
    <div class="marquee-fade-wrapper">
      <div class="flex gap-14 items-center animate-marquee whitespace-nowrap">
        {(() => {
          const logos = [
            { src: '/logos/delta.png', alt: 'Delta Safety Training', href: 'https://www.deltasafetytraining.nl' },
            { src: '/logos/clubcollect.png', alt: 'Club Collect', href: 'https://www.clubcollect.com', h: 'h-6' },
            { src: '/logos/bootman.png', alt: 'Bootman', href: 'https://www.bootman.nl', h: 'h-6' },
            { src: '/logos/ciphix.png', alt: 'Ciphix', href: 'https://www.ciphix.com', h: 'h-6' },
            { src: '/logos/freeday.png', alt: 'Freeday', href: 'https://www.freeday.ai' },
            { src: '/logos/cjob.png', alt: 'C-Job Naval Architects', href: 'https://c-job.com' },
            { src: '/logos/rebelsai.png', alt: 'RebelsAI', href: 'https://www.rebelsai.nl' },
            { src: '/twelve-logo.svg', alt: 'Twelve', href: 'https://www.twelve.eu', h: 'h-6' },
          ];
          return [...logos, ...logos, ...logos, ...logos].map((logo, i) => (
            <a href={logo.href} target="_blank" rel="noopener" class="inline-flex items-center shrink-0">
              <img src={logo.src} alt={logo.alt} class={`${logo.h ?? 'h-7'} w-auto object-contain grayscale opacity-35 hover:grayscale-0 hover:opacity-80 transition-all duration-300`} />
            </a>
          ));
        })()}
      </div>
    </div>
  </section>

  <style>
    /* Hero grid lines */
    .hero-grid-lines {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      opacity: 0.04;
    }
    .hero-line-v {
      position: absolute;
      width: 1px;
      top: 0; bottom: 0;
      background: #8aaaff;
    }
    .hero-line-h {
      position: absolute;
      height: 1px;
      left: 0; right: 0;
      background: #8aaaff;
    }
    /* Marquee */
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 35s linear infinite;
      width: max-content;
    }
    .animate-marquee:hover {
      animation-play-state: paused;
    }
    /* Dashboard mockup */
    .hero-visual {
      margin-top: 56px;
      position: relative;
      max-width: 780px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-dashboard {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 24px;
      position: relative;
      overflow: hidden;
    }
    .hero-dashboard::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(26,79,255,0.4), transparent);
    }
    .dash-topbar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .dash-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      flex-shrink: 0;
    }
    .dash-tab {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      padding: 4px 12px;
      border-radius: 6px;
      margin-left: 4px;
    }
    .dash-tab-active {
      background: rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.5);
    }
    .dash-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .dash-metric {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      text-align: left;
    }
    .dash-metric-label {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: rgba(255,255,255,0.25);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }
    .dash-metric-value {
      font-size: 22px;
      font-weight: 800;
      color: #f5f3f0;
      letter-spacing: -0.02em;
    }
    .dash-metric-change {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: #8aaaff;
      margin-top: 4px;
    }
    .dash-chart {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      height: 100px;
      display: flex;
      align-items: flex-end;
      gap: 6px;
    }
    .dash-bar {
      flex: 1;
      background: linear-gradient(to top, rgba(26,79,255,0.3), rgba(26,79,255,0.08));
      border-radius: 3px 3px 0 0;
      min-height: 8px;
    }
    @media (max-width: 640px) {
      .dash-grid { grid-template-columns: 1fr 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 2; }
      .hero-visual { margin-top: 40px; }
    }
    @media (max-width: 400px) {
      .dash-grid { grid-template-columns: 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 1; }
      .hero-dashboard { padding: 16px; }
    }
    /* Fade edges */
    .marquee-fade-wrapper { position: relative; }
    .marquee-fade-wrapper::before,
    .marquee-fade-wrapper::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 80px;
      z-index: 2;
      pointer-events: none;
    }
    .marquee-fade-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #f5f3f0, transparent);
    }
    .marquee-fade-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #f5f3f0, transparent);
    }
  </style>

  <!-- Pain Section -->
  <section class="py-24 px-6 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Sound familiar?</div>
      <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em; max-width: 640px">You're making decisions on data you <span class="text-brand-600">don't trust.</span></h2>
      <p class="text-lg text-ink/55 mb-12" style="max-width: 560px">It's Monday morning. You open your dashboard. Then you check the spreadsheet. The numbers don't match. You ask your finance lead. Different number again. Here's what that actually costs you:</p>

      <div class="flex flex-col border-t border-ink/10">

        <div class="grid md:grid-cols-2 gap-10 py-10 border-b border-ink/8">
          <h3 class="text-xl font-bold text-ink leading-snug" style="border-left: 3px solid #1a4fff; padding-left: 20px">Three answers to the same question</h3>
          <div>
            <p class="text-ink/60 text-sm leading-relaxed mb-3">Sales says revenue is up. Finance says margins are down. Operations doesn't have the data yet. Every meeting starts with 20 minutes of arguing about whose spreadsheet is right.</p>
            <span class="font-mono text-xs text-brand-600 uppercase tracking-wider">Cost: every strategic decision starts on shaky ground.</span>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-10 py-10 border-b border-ink/8">
          <h3 class="text-xl font-bold text-ink leading-snug" style="border-left: 3px solid #1a4fff; padding-left: 20px">Board prep takes a week</h3>
          <div>
            <p class="text-ink/60 text-sm leading-relaxed mb-3">Every board meeting is preceded by days of pulling data, reconciling numbers, and formatting slides. Your finance lead spends 3–5 days per month on reporting that should take 15 minutes.</p>
            <span class="font-mono text-xs text-brand-600 uppercase tracking-wider">Cost: senior talent buried in manual data wrangling.</span>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-10 py-10">
          <h3 class="text-xl font-bold text-ink leading-snug" style="border-left: 3px solid #1a4fff; padding-left: 20px">Dashboards nobody uses</h3>
          <div>
            <p class="text-ink/60 text-sm leading-relaxed mb-3">You built them. Or someone did, once. Now they're stale, half-broken, and everyone's gone back to exporting CSVs. The data underneath was never reliable enough to build on.</p>
            <span class="font-mono text-xs text-brand-600 uppercase tracking-wider">Cost: investment wasted, trust in data eroded further.</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Solution / Benefits -->
  <section id="impact" class="py-24 px-6 bg-warm">
    <div class="max-w-6xl mx-auto">

      <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">The Semantic Nexus</div>
      <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em; max-width: 640px">One <span class="text-brand-600">truth.</span> Every team.<br>Every decision.</h2>
      <p class="text-lg text-ink/55 mb-12" style="max-width: 560px">We build the data foundation underneath your business. Not another dashboard, but the layer that makes every dashboard, report, and KPI trustworthy.</p>

      <!-- Before / After -->
      <div class="grid md:grid-cols-2 gap-4 mb-10">

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="flex items-center gap-2 font-mono text-xs text-ink/40 uppercase tracking-wider mb-5">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            Before MAXQ
          </div>
          <ul class="flex flex-col gap-0">
            {['Metrics defined differently across departments', 'Manual exports and reconciliation every month', 'Dashboards that break when someone changes a column', 'No one knows which number is "the real one"', 'Data questions need a developer to answer'].map(item => (
              <li class="flex gap-3 text-sm text-ink/55 py-2.5 border-b border-ink/8 last:border-0">
                <span class="text-ink/30 font-bold shrink-0">✗</span>{item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-brand-600">
          <div class="flex items-center gap-2 font-mono text-xs text-brand-600 uppercase tracking-wider mb-5">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            After MAXQ
          </div>
          <ul class="flex flex-col gap-0">
            {['Every metric defined once, visible to everyone', 'Board decks pull automatically, no scramble', 'Bad data caught before it reaches your boardroom', 'Finance, sales, and ops all see the same truth', 'Ask your data questions in plain English via AI'].map(item => (
              <li class="flex gap-3 text-sm text-ink/70 py-2.5 border-b border-ink/8 last:border-0">
                <span class="text-brand-600 font-bold shrink-0">✓</span>{item}
              </li>
            ))}
          </ul>
        </div>

      </div>

      <div class="text-center mb-16">
        <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-ink text-cream font-semibold px-8 py-3.5 rounded-full hover:bg-ink/80 transition-colors text-sm">
          See what this looks like for your business
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <!-- Numbered benefits -->
      <div class="border-t border-ink/10">
        {[
          { n: '01', h: 'Every metric, defined once', p: 'Every KPI gets its own scorecard with the formula, the source, and the business context. No more debates about what "revenue" means.' },
          { n: '02', h: 'Bad data caught automatically', p: 'Problems get caught before they reach a decision-maker. Each test has an owner, a direct link to fix the issue at source, and a clear description.' },
          { n: '03', h: 'See exactly where your data is', p: 'A live view of your full data pipeline: extraction, transformation, delivery. Every stakeholder can see how data flows, which systems are involved, what\'s current, and where bottlenecks sit.' },
          { n: '04', h: 'Each department gets their own view', p: 'Finance sees margins and cash flow. Sales sees pipeline and unit economics. Operations sees utilisation and capacity. Same data, purpose-built views for the people who need them.' },
          { n: '05', h: 'Ask your data questions in plain English', p: 'An AI layer connected directly to your data model. Query live data through Claude and other AI systems. No SQL, no waiting for a developer. Your single source of truth, accessible through conversation.' },
          { n: '06', h: 'KPIs straight to the boardroom', p: 'Monthly company KPIs shared directly with shareholders through an automated metrics exchange. No manual exports, no slide decks cobbled together at midnight. Always current, always consistent.' },
        ].map(row => (
          <div class="grid md:grid-cols-[64px_1fr_1.2fr] gap-6 py-10 border-b border-ink/8 last:border-0 items-start">
            <span class="font-mono text-sm font-medium text-brand-600">{row.n}</span>
            <h3 class="text-lg font-bold text-ink" style="letter-spacing: -0.01em">{row.h}</h3>
            <p class="text-sm text-ink/60 leading-relaxed">{row.p}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Product Items -->
  <section id="product-items" class="py-24 px-6 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">What you get</div>
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Architecture features</h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">Five components that together give your organisation complete visibility into its data — from raw sources to AI-powered querying.</p>
      </div>

      <!-- Top row: 3 cards -->
      <div class="grid md:grid-cols-3 gap-4 mb-4">

        <!-- Data Model Explorer -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 8h6M9 16h4" />
            </svg>
          </div>
