---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Nav -->
  <nav class="fixed top-0 w-full z-50 bg-cream/90 backdrop-blur border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center">
        <img src="/semantic-nexus-logo.svg" alt="Semantic Nexus" class="h-12 w-auto" />
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm text-ink/60 font-medium">
        <a href="#impact" class="hover:text-brand-600 transition-colors">Impact</a>
        <a href="#product-items" class="hover:text-brand-600 transition-colors">Product Items</a>
        <a href="#frameworks" class="hover:text-brand-600 transition-colors">Frameworks</a>
        <a href="#stack" class="hover:text-brand-600 transition-colors">Tech Stack</a>
        <a href="#case-studies" class="hover:text-brand-600 transition-colors">Case Studies</a>
        <a href="#pricing" class="hover:text-brand-600 transition-colors">Pricing</a>
        <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="bg-ink text-cream px-5 py-2 rounded-full text-sm font-semibold hover:bg-ink/80 transition-colors">
          Contact us
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-ink text-cream relative overflow-hidden">
    <div class="hero-grid-lines" aria-hidden="true">
      <div class="hero-line-v" style="left: 20%"></div>
      <div class="hero-line-v" style="left: 40%"></div>
      <div class="hero-line-v" style="left: 60%"></div>
      <div class="hero-line-v" style="left: 80%"></div>
      <div class="hero-line-h" style="top: 25%"></div>
      <div class="hero-line-h" style="top: 50%"></div>
      <div class="hero-line-h" style="top: 75%"></div>
    </div>
    <div class="max-w-5xl mx-auto text-center relative">
      <div class="inline-block px-4 py-1.5 rounded-full font-mono text-xs text-white/45 uppercase tracking-widest mb-8" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.10)">
        MAXQ Analytics / Semantic Nexus
      </div>
      <h1 class="font-black mb-7 leading-none mx-auto" style="font-size: clamp(42px, 7.5vw, 88px); letter-spacing: -0.04em; max-width: 820px">
        Everyone has<br>different numbers.<br><span class="text-brand-300">That ends here.</span>
      </h1>
      <p class="text-lg md:text-xl text-cream/55 max-w-xl mx-auto mb-10 leading-relaxed">
        One source of truth for your entire business, from raw data to boardroom KPIs. So every team works from the same numbers, every time.
      </p>
      <div class="flex gap-3 justify-center flex-wrap mb-14">
        <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-cream text-ink font-semibold px-8 py-3.5 rounded-full hover:bg-white transition-colors text-sm">
          Schedule a Call
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#impact" class="inline-flex items-center gap-2 text-cream font-semibold px-8 py-3.5 rounded-full transition-colors text-sm" style="border: 1px solid rgba(255,255,255,0.20)" onmouseover="this.style.borderColor='rgba(255,255,255,0.50)';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.20)';this.style.background=''">
          See how it works
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
        </a>
      </div>
      <!-- Dashboard mockup -->
      <div class="hero-visual">
        <div class="hero-dashboard">
          <div class="dash-topbar">
            <span class="dash-dot" style="background: rgba(96,165,250,0.5)"></span>
            <span class="dash-dot"></span>
            <span class="dash-dot"></span>
            <span class="dash-tab dash-tab-active">Overview</span>
            <span class="dash-tab">Revenue</span>
            <span class="dash-tab">Pipeline</span>
          </div>
          <div class="dash-grid">
            <div class="dash-metric">
              <div class="dash-metric-label">Monthly Revenue</div>
              <div class="dash-metric-value">&euro;847K</div>
              <div class="dash-metric-change">+12.4% vs last month</div>
            </div>
            <div class="dash-metric">
              <div class="dash-metric-label">Gross Margin</div>
              <div class="dash-metric-value">68.2%</div>
              <div class="dash-metric-change">+3.1pp vs target</div>
            </div>
            <div class="dash-metric">
              <div class="dash-metric-label">Active Contracts</div>
              <div class="dash-metric-value">142</div>
              <div class="dash-metric-change">Same source, every team</div>
            </div>
          </div>
          <div class="dash-chart">
            <div class="dash-bar" style="height: 35%"></div>
            <div class="dash-bar" style="height: 42%"></div>
            <div class="dash-bar" style="height: 38%"></div>
            <div class="dash-bar" style="height: 55%"></div>
            <div class="dash-bar" style="height: 48%"></div>
            <div class="dash-bar" style="height: 62%"></div>
            <div class="dash-bar" style="height: 58%"></div>
            <div class="dash-bar" style="height: 71%"></div>
            <div class="dash-bar" style="height: 65%"></div>
            <div class="dash-bar" style="height: 78%"></div>
            <div class="dash-bar" style="height: 72%"></div>
            <div class="dash-bar" style="height: 85%"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 px-6 bg-ink text-cream">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 text-center">
        {[
          { value: '8', label: 'Active clients' },
          { value: '460+', label: 'FTE across clients' },
          { value: '€63M+', label: 'Combined annual revenue' },
          { value: '25k+', label: 'Analytics API requests / day' },
        ].map(stat => (
          <div class="flex flex-col gap-2">
            <span class="text-4xl md:text-5xl font-black text-cream tracking-tight" style="letter-spacing: -0.03em">{stat.value}</span>
            <span class="text-xs font-mono text-cream/40 leading-snug uppercase tracking-wider">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Logo Carousel -->
  <section class="py-12 bg-cream border-b border-ink/10 overflow-hidden">
    <p class="text-center text-xs font-mono font-medium text-ink/40 uppercase tracking-widest mb-8">Trusted by</p>
    <div class="marquee-fade-wrapper">
      <div class="flex gap-14 items-center animate-marquee whitespace-nowrap">
        {[
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/6242c6dc816b4f62d5c56f90_Delta-Safety-Training.png', alt: 'Delta Safety Training', href: 'https://www.deltasafetytraining.nl' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/6242c6d49b1ad2fcefbd8d2d_logo-clubcollect%20(1).png', alt: 'Club Collect', href: 'https://www.clubcollect.com', h: 'h-6' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/648aec0b84ca07f77700a234_bootman_logo.png', alt: 'Bootman', href: 'https://www.bootman.nl', h: 'h-6' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/649150688a5331c19bc40445_ciphix_logo.png', alt: 'Ciphix', href: 'https://www.ciphix.com', h: 'h-6' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/64e9b09b165f6871809ceb5e_Freeday-logo.png', alt: 'Freeday', href: 'https://www.freeday.ai' },
          { src: '/cjob-logo.jpeg', alt: 'C-Job Naval Architects', href: 'https://c-job.com' },
          { src: '/rebelsai-logo.jpeg', alt: 'RebelsAI', href: 'https://www.rebelsai.nl' },
          { src: '/twelve-logo.svg', alt: 'Twelve', href: 'https://www.twelve.eu', h: 'h-6' },
          /* duplicate set for seamless loop */
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/6242c6dc816b4f62d5c56f90_Delta-Safety-Training.png', alt: 'Delta Safety Training', href: 'https://www.deltasafetytraining.nl' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/6242c6d49b1ad2fcefbd8d2d_logo-clubcollect%20(1).png', alt: 'Club Collect', href: 'https://www.clubcollect.com', h: 'h-6' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/648aec0b84ca07f77700a234_bootman_logo.png', alt: 'Bootman', href: 'https://www.bootman.nl', h: 'h-6' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/649150688a5331c19bc40445_ciphix_logo.png', alt: 'Ciphix', href: 'https://www.ciphix.com', h: 'h-6' },
          { src: 'https://cdn.prod.website-files.com/5fe86bb8d7bed24c79daf68d/64e9b09b165f6871809ceb5e_Freeday-logo.png', alt: 'Freeday', href: 'https://www.freeday.ai' },
          { src: '/cjob-logo.jpeg', alt: 'C-Job Naval Architects', href: 'https://c-job.com' },
          { src: '/rebelsai-logo.jpeg', alt: 'RebelsAI', href: 'https://www.rebelsai.nl' },
          { src: '/twelve-logo.svg', alt: 'Twelve', href: 'https://www.twelve.eu', h: 'h-6' },
        ].map(logo => (
          <a href={logo.href} target="_blank" rel="noopener" class="inline-flex items-center shrink-0">
            <img src={logo.src} alt={logo.alt} class={`${logo.h ?? 'h-7'} w-auto object-contain grayscale opacity-35 hover:grayscale-0 hover:opacity-80 transition-all duration-300`} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Hero grid lines */
    .hero-grid-lines {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      opacity: 0.04;
    }
    .hero-line-v {
      position: absolute;
      width: 1px;
      top: 0; bottom: 0;
      background: #8aaaff;
    }
    .hero-line-h {
      position: absolute;
      height: 1px;
      left: 0; right: 0;
      background: #8aaaff;
    }
    /* Marquee */
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 35s linear infinite;
      width: max-content;
    }
    .animate-marquee:hover {
      animation-play-state: paused;
    }
    /* Dashboard mockup */
    .hero-visual {
      margin-top: 56px;
      position: relative;
      max-width: 780px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-dashboard {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 24px;
      position: relative;
      overflow: hidden;
    }
    .hero-dashboard::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(26,79,255,0.4), transparent);
    }
    .dash-topbar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .dash-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      flex-shrink: 0;
    }
    .dash-tab {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      padding: 4px 12px;
      border-radius: 6px;
      margin-left: 4px;
    }
    .dash-tab-active {
      background: rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.5);
    }
    .dash-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .dash-metric {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      text-align: left;
    }
    .dash-metric-label {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: rgba(255,255,255,0.25);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }
    .dash-metric-value {
      font-size: 22px;
      font-weight: 800;
      color: #f5f3f0;
      letter-spacing: -0.02em;
    }
    .dash-metric-change {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: #8aaaff;
      margin-top: 4px;
    }
    .dash-chart {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      height: 100px;
      display: flex;
      align-items: flex-end;
      gap: 6px;
    }
    .dash-bar {
      flex: 1;
      background: linear-gradient(to top, rgba(26,79,255,0.3), rgba(26,79,255,0.08));
      border-radius: 3px 3px 0 0;
      min-height: 8px;
    }
    @media (max-width: 640px) {
      .dash-grid { grid-template-columns: 1fr 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 2; }
      .hero-visual { margin-top: 40px; }
    }
    @media (max-width: 400px) {
      .dash-grid { grid-template-columns: 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 1; }
      .hero-dashboard { padding: 16px; }
    }
    /* Fade edges */
    .marquee-fade-wrapper { position: relative; }
    .marquee-fade-wrapper::before,
    .marquee-fade-wrapper::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 80px;
      z-index: 2;
      pointer-events: none;
    }
    .marquee-fade-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #f5f3f0, transparent);
    }
    .marquee-fade-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #f5f3f0, transparent);
    }
  </style>

  <!-- Business Impact -->
  <section id="impact" class="py-24 px-6 bg-warm">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Business impact</div>
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">What it brings to your business</h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">The Semantic Nexus is designed to remove ambiguity, reduce overhead, and give every team a reliable foundation to make decisions from.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-4">

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="text-3xl font-black text-brand-600 mb-3" style="letter-spacing: -0.02em">One truth</div>
          <h3 class="text-base font-bold text-ink mb-2">Aligned across every team</h3>
          <p class="text-ink/60 text-sm leading-relaxed">Leadership, finance, and operations all work from the same semantic layer. No more conflicting spreadsheets or disputed numbers — every metric is defined once and used everywhere.</p>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="text-3xl font-black text-brand-600 mb-3" style="letter-spacing: -0.02em">Less overhead</div>
          <h3 class="text-base font-bold text-ink mb-2">Faster ad-hoc requests</h3>
          <p class="text-ink/60 text-sm leading-relaxed">Finance and planning managers run their own calculations directly against the semantic model. Your team members spend less time answering one-off questions and more time building what matters.</p>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="text-3xl font-black text-brand-600 mb-3" style="letter-spacing: -0.02em">Full trust</div>
          <h3 class="text-base font-bold text-ink mb-2">Data you can rely on</h3>
          <p class="text-ink/60 text-sm leading-relaxed">Automated data entry tests and pipeline freshness monitoring catch issues before they reach decision-makers. Your reports are only as good as the data behind them — so we make sure it stays clean.</p>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="text-3xl font-black text-brand-600 mb-3" style="letter-spacing: -0.02em">Stakeholder ready</div>
          <h3 class="text-base font-bold text-ink mb-2">KPIs straight to the boardroom</h3>
          <p class="text-ink/60 text-sm leading-relaxed">After a successful deployment, monthly company KPIs can be shared directly with shareholders and stakeholders through the metrics exchange — no manual exports, no preparation overhead.</p>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="text-3xl font-black text-brand-600 mb-3" style="letter-spacing: -0.02em">Full ownership</div>
          <h3 class="text-base font-bold text-ink mb-2">Your data, your infrastructure</h3>
          <p class="text-ink/60 text-sm leading-relaxed">Every repository is version-controlled and owned by the client. No vendor lock-in, no black-box dependencies. You can switch tools or engineers without losing your architecture.</p>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="text-3xl font-black text-brand-600 mb-3" style="letter-spacing: -0.02em">AI native</div>
          <h3 class="text-base font-bold text-ink mb-2">Natural language on your data</h3>
          <p class="text-ink/60 text-sm leading-relaxed">With the MCP Server, your semantic layer becomes accessible to AI agents. Leverage your single source of truth for agentic workflows and performance reviews.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Product Items -->
  <section id="product-items" class="py-24 px-6 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">What you get</div>
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Product items</h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">Five components that together give your organisation complete visibility into its data — from raw sources to AI-powered querying.</p>
      </div>

      <!-- Top row: 3 cards -->
      <div class="grid md:grid-cols-3 gap-4 mb-4">

        <!-- Data Model Explorer -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 8h6M9 16h4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Data Model Explorer</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">A unified, navigable interface that maps your entire data architecture. Source tables are shown post-transformation with aggregations for fast analysis. Each critical metric gets its own dedicated page with a scorecard, numerator/denominator breakdown, and business context provided by the client.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data%20Model%20Explorer" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

        <!-- Data Entry Tests -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Data Entry Tests</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">Automated, client-specific tests that continuously validate data entries and business workflows. Each test is assigned an owner, a deeplink for direct resolution at the source, a context description, and a unique test ID — keeping data quality accountable and easy to communicate across teams.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data+Entry+Tests" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

        <!-- Pipeline Freshness -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Pipeline Freshness</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">A live flowchart of your full data pipeline from extraction through transformation to consumption. Every stakeholder can see how data moves across your architecture — which systems are involved, what the current status is, and where bottlenecks occur. Invaluable when planning refactors or expansions.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data+Freshness" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

      </div>

      <!-- Bottom row: 2 cards centred -->
      <div class="grid md:grid-cols-2 gap-4 md:max-w-3xl md:mx-auto">

        <!-- Domain Reports -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
