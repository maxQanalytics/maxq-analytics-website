---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import stackSvg from '../diagrams/tech-stack-2026-10-08.svg?raw';
---

<Layout>
  <SiteNav />

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-ink text-cream relative overflow-hidden">
    <div class="hero-grid-lines" aria-hidden="true">
      <div class="hero-line-v" style="left: 20%"></div>
      <div class="hero-line-v" style="left: 40%"></div>
      <div class="hero-line-v" style="left: 60%"></div>
      <div class="hero-line-v" style="left: 80%"></div>
      <div class="hero-line-h" style="top: 25%"></div>
      <div class="hero-line-h" style="top: 50%"></div>
      <div class="hero-line-h" style="top: 75%"></div>
    </div>
    <div class="max-w-5xl mx-auto text-center relative">
      <h1 class="font-black mb-7 leading-none mx-auto" style="font-size: clamp(36px, 5.8vw, 68px); letter-spacing: -0.03em; max-width: 820px">
        Agentic Analytics<br><span class="text-brand-300">On all your data</span>
      </h1>
      <p class="text-lg md:text-xl text-cream/90 max-w-xl mx-auto mb-10 leading-relaxed">
        One source of truth for your entire business, from raw data to company-wide agentic workflows. So every team works with the same numbers, every time.
      </p>
      <!-- Dashboard mockup -->
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 px-6 bg-ink text-cream">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 text-center">
        {[
          { value: '9', label: 'Active deployments' },
          { value: '460+', label: 'Employees connected' },
          { value: '€65M+', label: 'Tracked annual revenue' },
          { value: '25k+', label: 'Analytics API requests / day' },
        ].map(stat => (
          <div class="flex flex-col gap-2">
            <span class="text-4xl md:text-5xl font-black text-cream tracking-tight" style="letter-spacing: -0.03em">{stat.value}</span>
            <span class="text-sm font-mono font-medium text-cream leading-snug uppercase tracking-wider">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Logo Carousel -->
  <section class="py-12 bg-cream">
    <div class="max-w-6xl mx-auto overflow-hidden">
    <p class="text-center text-xs font-mono font-medium text-ink/40 uppercase tracking-widest mb-8">Trusted by</p>
    <div class="marquee-fade-wrapper">
      <div class="flex gap-14 items-center animate-marquee whitespace-nowrap">
        {(() => {
          const logos = [
            { src: '/logos/delta.png', alt: 'Delta Safety Training', href: 'https://www.deltasafetytraining.nl' },
            { src: '/logos/clubcollect.png', alt: 'Club Collect', href: 'https://www.clubcollect.com', h: 'h-6' },
            { src: '/logos/ciphix.png', alt: 'Ciphix', href: 'https://www.ciphix.com', h: 'h-6' },
            { src: '/logos/freeday.svg', alt: 'Freeday', href: 'https://www.freeday.ai' },
            { src: '/logos/cjob.png', alt: 'C-Job Naval Architects', href: 'https://c-job.com' },
            { src: '/logos/rebelsai.png', alt: 'RebelsAI', href: 'https://www.rebelsai.nl' },
            { src: '/twelve-logo.svg', alt: 'Twelve', href: 'https://www.twelve.eu', h: 'h-6' },
            { src: '/logos/wyngaard.svg', alt: 'Wyngaard Kaas', href: 'https://www.wijngaardkaas.nl/nl_NL/', h: 'h-8' },
            { src: '/logos/twizzit.png', alt: 'Twizzit', href: 'https://www.twizzit.com/nl-be/', h: 'h-7' },
          ];
          return [...logos, ...logos, ...logos, ...logos].map((logo, i) => (
            <a href={logo.href} target="_blank" rel="noopener" class="inline-flex items-center shrink-0">
              <img src={logo.src} alt={logo.alt} class={`${logo.h ?? 'h-7'} w-auto object-contain hover:opacity-80 transition-opacity duration-300`} />
            </a>
          ));
        })()}
      </div>
    </div>
    </div>
  </section>

  <style>
    /* Hero grid lines */
    .hero-grid-lines {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      opacity: 0.04;
    }
    .hero-line-v {
      position: absolute;
      width: 1px;
      top: 0; bottom: 0;
      background: #8aaaff;
    }
    .hero-line-h {
      position: absolute;
      height: 1px;
      left: 0; right: 0;
      background: #8aaaff;
    }
    /* Marquee */
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 35s linear infinite;
      width: max-content;
    }
    @media (hover: hover) {
      .animate-marquee:hover {
        animation-play-state: paused;
      }
    }
    /* Dashboard mockup */
    .hero-visual {
      margin-top: 56px;
      position: relative;
      max-width: 780px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-dashboard {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 24px;
      position: relative;
      overflow: hidden;
    }
    .hero-dashboard::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(26,79,255,0.4), transparent);
    }
    .dash-topbar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .dash-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      flex-shrink: 0;
    }
    .dash-tab {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      padding: 4px 12px;
      border-radius: 6px;
      margin-left: 4px;
    }
    .dash-tab-active {
      background: rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.5);
    }
    .dash-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .dash-metric {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      text-align: left;
    }
    .dash-metric-label {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: rgba(255,255,255,0.25);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }
    .dash-metric-value {
      font-size: 22px;
      font-weight: 800;
      color: #f5f3f0;
      letter-spacing: -0.02em;
    }
    .dash-metric-change {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: #8aaaff;
      margin-top: 4px;
    }
    .dash-chart {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      height: 100px;
      display: flex;
      align-items: flex-end;
      gap: 6px;
    }
    .dash-bar {
      flex: 1;
      background: linear-gradient(to top, rgba(26,79,255,0.3), rgba(26,79,255,0.08));
      border-radius: 3px 3px 0 0;
      min-height: 8px;
    }
    @media (max-width: 640px) {
      .dash-grid { grid-template-columns: 1fr 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 2; }
      .hero-visual { margin-top: 40px; }
    }
    @media (max-width: 400px) {
      .dash-grid { grid-template-columns: 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 1; }
      .hero-dashboard { padding: 16px; }
    }
    /* Fade edges */
    .marquee-fade-wrapper { position: relative; }
    .marquee-fade-wrapper::before,
    .marquee-fade-wrapper::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 80px;
      z-index: 2;
      pointer-events: none;
    }
    .marquee-fade-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #f5f3f0, transparent);
    }
    .marquee-fade-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #f5f3f0, transparent);
    }
  </style>


  <!-- Product Items -->
  <section id="features" class="py-24 px-6 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Deployed with <span class="text-brand-600">open-source</span> components</h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">Our open-source Semantic Nexus architecture gives your organisation complete visibility into its data — from raw sources to AI-powered querying.</p>
      </div>

      <!-- Top row: 3 cards -->
      <div class="grid md:grid-cols-3 gap-4 mb-4">

        <!-- Domain Reports -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Domain Reports</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">Three purpose-built reporting domains aligned to how companies are structured: <strong>Commerce Atlas</strong> (go-to-market, unit economics), <strong>Finance Atlas</strong> (margins, financial operations), and <strong>Operations Atlas</strong> (utilisation, capacity). Each delivers periodic dashboards and trend analysis tailored to the domain's owners and targets.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Domain+Reports" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Details →</a>
        </div>

        <!-- Data Model Explorer -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 8h6M9 16h4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Data Model Explorer</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">A unified, navigable interface that maps your entire data architecture. Source tables are shown post-transformation with aggregations for fast analysis. Each critical metric gets its own dedicated page with a scorecard, numerator/denominator breakdown, and business context provided by the client.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data%20Model%20Explorer" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Details →</a>
        </div>

        <!-- Data Entry Tests -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Data Entry Tests</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">Automated, client-specific tests that continuously validate data entries and business workflows. Each test is assigned an owner, a deeplink for direct resolution at the source, a context description, and a unique test ID — keeping data quality accountable and easy to communicate across teams.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data+Entry+Tests" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Details →</a>
        </div>

      </div>

      <!-- Bottom row: 2 cards centred -->
      <div class="grid md:grid-cols-2 gap-4 md:max-w-3xl md:mx-auto">

        <!-- Pipeline Freshness -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Pipeline Freshness</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">A live flowchart of your full data pipeline from extraction through transformation to consumption. Every stakeholder can see how data moves across your architecture — which systems are involved, what the current status is, and where bottlenecks occur. Invaluable when planning refactors or expansions.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data+Freshness" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Details →</a>
        </div>

        <!-- MCP Servers -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">MCP Servers</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">We configure multiple Model Context Protocol servers tailored to specific use cases and agentic workflows — each one exposing the right slice of your semantic layer to the right AI system. Whether it's a customer-facing agent, an internal analyst assistant, or an automated reporting workflow, every MCP server is purpose-built for how that agent actually needs to query your data.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">Details →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section id="stack" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Built on <span class="text-brand-600">best-in-class</span> tooling</h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">We work with the leading data stack tools, keeping clients in full control of their own infrastructure. We have a tooling-agnostic approach in designing the Semantic Nexus, with a strong preference for open-source and self-hosted applications.</p>
      </div>

      <!-- Flow chart, tablet and desktop: generated SVG (scripts/render-tech-stack.mjs) -->
      <div class="hidden md:block">
        <Fragment set:html={stackSvg} />
      </div>

      <!-- Flow chart, phones: stacked cards -->
      <div class="md:hidden flex flex-col gap-3">
        <div class="rounded-2xl border border-ink/10 bg-cream p-5">
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Sources</p>
          <p class="text-sm text-ink/60">Product database (PostgreSQL, MySQL) · Bookkeeping (Exact Online, Yuki) · CRM (HubSpot) · ERP (Float, Infor) · Customer care (Freshdesk, Zendesk) · Spreadsheets (Google Sheets, Excel)</p>
        </div>
        <div class="flex items-center justify-center text-ink/30">
          <svg class="w-5 h-5 rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-warm p-5">
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Extraction · streaming (product database)</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Debezium</span>
          </div>
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mt-4 mb-2">Extraction · batch (all other sources)</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Airbyte</span>
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Hevo Data</span>
          </div>
        </div>
        <div class="flex items-center justify-center text-ink/30">
          <svg class="w-5 h-5 rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-warm p-5">
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Warehouse · real-time (from the stream)</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">ClickHouse</span>
          </div>
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mt-4 mb-2">Warehouse · batch</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">BigQuery</span>
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Snowflake</span>
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Microsoft Fabric</span>
          </div>
        </div>
        <div class="flex items-center justify-center text-ink/30">
          <svg class="w-5 h-5 rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-warm p-5">
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Transformation</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">dbt</span>
          </div>
        </div>
        <div class="flex items-center justify-center text-ink/30">
          <svg class="w-5 h-5 rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-warm p-5">
          <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Semantic layer</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Cube</span>
            <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Microsoft Fabric</span>
          </div>
        </div>
        <div class="flex items-center justify-center text-ink/30">
          <svg class="w-5 h-5 rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-warm p-5 space-y-3">
          <div>
            <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Consumers · AI models</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Claude</span>
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">OpenAI</span>
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Gemini</span>
            </div>
          </div>
          <div>
            <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Consumers · MCPs</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-brand-600/40 text-ink/70">nao analytics</span>
            </div>
          </div>
          <div>
            <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Consumers · AI agents</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-brand-600/40 text-ink/70">Quality Guardian</span>
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">LangChain agents</span>
            </div>
          </div>
          <div>
            <p class="font-mono text-[10px] text-ink/40 uppercase tracking-wider mb-2">Consumers · Reports</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white border border-ink/10 text-ink/70">Data Studio</span>
