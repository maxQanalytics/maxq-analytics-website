---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  <SiteNav />

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-ink text-cream relative overflow-hidden">
    <div class="hero-grid-lines" aria-hidden="true">
      <div class="hero-line-v" style="left: 20%"></div>
      <div class="hero-line-v" style="left: 40%"></div>
      <div class="hero-line-v" style="left: 60%"></div>
      <div class="hero-line-v" style="left: 80%"></div>
      <div class="hero-line-h" style="top: 25%"></div>
      <div class="hero-line-h" style="top: 50%"></div>
      <div class="hero-line-h" style="top: 75%"></div>
    </div>
    <div class="max-w-5xl mx-auto text-center relative">
      <h1 class="font-black mb-7 leading-none mx-auto" style="font-size: clamp(42px, 7.5vw, 88px); letter-spacing: -0.04em; max-width: 820px">
        Agentic Analytics.<br><span class="text-brand-300">Starts here.</span>
      </h1>
      <p class="text-lg md:text-xl text-cream/55 max-w-xl mx-auto mb-10 leading-relaxed">
        One source of truth for your entire business, from raw data to boardroom KPIs. So every team works from the same numbers, every time.
      </p>
      <div class="flex gap-3 justify-center flex-wrap mb-14">
        <a href="#semantic-nexus" class="inline-flex items-center gap-2 text-cream font-semibold px-8 py-3.5 rounded-full transition-colors text-sm" style="border: 1px solid rgba(255,255,255,0.20)" onmouseover="this.style.borderColor='rgba(255,255,255,0.50)';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.20)';this.style.background=''">
          See how it works
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
        </a>
        <a href="https://calendly.com/philip-boontje" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-cream text-ink font-semibold px-8 py-3.5 rounded-full hover:bg-white transition-colors text-sm">
          Schedule a Call
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <!-- Dashboard mockup -->
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 px-6 bg-ink text-cream">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 text-center">
        {[
          { value: '9', label: 'Active clients' },
          { value: '460+', label: 'FTE across clients' },
          { value: '€65M+', label: 'Combined annual revenue' },
          { value: '25k+', label: 'Analytics API requests / day' },
        ].map(stat => (
          <div class="flex flex-col gap-2">
            <span class="text-4xl md:text-5xl font-black text-cream tracking-tight" style="letter-spacing: -0.03em">{stat.value}</span>
            <span class="text-xs font-mono text-cream leading-snug uppercase tracking-wider">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Logo Carousel -->
  <section class="py-12 bg-cream">
    <div class="max-w-6xl mx-auto overflow-hidden">
    <p class="text-center text-xs font-mono font-medium text-ink/40 uppercase tracking-widest mb-8">Trusted by</p>
    <div class="marquee-fade-wrapper">
      <div class="flex gap-14 items-center animate-marquee whitespace-nowrap">
        {(() => {
          const logos = [
            { src: '/logos/delta.png', alt: 'Delta Safety Training', href: 'https://www.deltasafetytraining.nl' },
            { src: '/logos/clubcollect.png', alt: 'Club Collect', href: 'https://www.clubcollect.com', h: 'h-6' },
            { src: '/logos/ciphix.png', alt: 'Ciphix', href: 'https://www.ciphix.com', h: 'h-6' },
            { src: '/logos/freeday.png', alt: 'Freeday', href: 'https://www.freeday.ai' },
            { src: '/logos/cjob.png', alt: 'C-Job Naval Architects', href: 'https://c-job.com' },
            { src: '/logos/rebelsai.png', alt: 'RebelsAI', href: 'https://www.rebelsai.nl' },
            { src: '/twelve-logo.svg', alt: 'Twelve', href: 'https://www.twelve.eu', h: 'h-6' },
            { src: '/logos/wyngaard.svg', alt: 'Wyngaard Kaas', href: 'https://www.wijngaardkaas.nl/nl_NL/', h: 'h-8' },
            { src: '/logos/twizzit.png', alt: 'Twizzit', href: 'https://www.twizzit.com/nl-be/', h: 'h-7' },
          ];
          return [...logos, ...logos, ...logos, ...logos].map((logo, i) => (
            <a href={logo.href} target="_blank" rel="noopener" class="inline-flex items-center shrink-0">
              <img src={logo.src} alt={logo.alt} class={`${logo.h ?? 'h-7'} w-auto object-contain grayscale opacity-35 hover:grayscale-0 hover:opacity-80 transition-all duration-300`} />
            </a>
          ));
        })()}
      </div>
    </div>
    </div>
  </section>

  <style>
    /* Hero grid lines */
    .hero-grid-lines {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      opacity: 0.04;
    }
    .hero-line-v {
      position: absolute;
      width: 1px;
      top: 0; bottom: 0;
      background: #8aaaff;
    }
    .hero-line-h {
      position: absolute;
      height: 1px;
      left: 0; right: 0;
      background: #8aaaff;
    }
    /* Marquee */
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 35s linear infinite;
      width: max-content;
    }
    @media (hover: hover) {
      .animate-marquee:hover {
        animation-play-state: paused;
      }
    }
    /* Dashboard mockup */
    .hero-visual {
      margin-top: 56px;
      position: relative;
      max-width: 780px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-dashboard {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 24px;
      position: relative;
      overflow: hidden;
    }
    .hero-dashboard::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(26,79,255,0.4), transparent);
    }
    .dash-topbar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .dash-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      flex-shrink: 0;
    }
    .dash-tab {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      padding: 4px 12px;
      border-radius: 6px;
      margin-left: 4px;
    }
    .dash-tab-active {
      background: rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.5);
    }
    .dash-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .dash-metric {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      text-align: left;
    }
    .dash-metric-label {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: rgba(255,255,255,0.25);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }
    .dash-metric-value {
      font-size: 22px;
      font-weight: 800;
      color: #f5f3f0;
      letter-spacing: -0.02em;
    }
    .dash-metric-change {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: #8aaaff;
      margin-top: 4px;
    }
    .dash-chart {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 16px;
      height: 100px;
      display: flex;
      align-items: flex-end;
      gap: 6px;
    }
    .dash-bar {
      flex: 1;
      background: linear-gradient(to top, rgba(26,79,255,0.3), rgba(26,79,255,0.08));
      border-radius: 3px 3px 0 0;
      min-height: 8px;
    }
    @media (max-width: 640px) {
      .dash-grid { grid-template-columns: 1fr 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 2; }
      .hero-visual { margin-top: 40px; }
    }
    @media (max-width: 400px) {
      .dash-grid { grid-template-columns: 1fr; }
      .dash-metric:nth-child(3) { grid-column: span 1; }
      .hero-dashboard { padding: 16px; }
    }
    /* Fade edges */
    .marquee-fade-wrapper { position: relative; }
    .marquee-fade-wrapper::before,
    .marquee-fade-wrapper::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 80px;
      z-index: 2;
      pointer-events: none;
    }
    .marquee-fade-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #f5f3f0, transparent);
    }
    .marquee-fade-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #f5f3f0, transparent);
    }
  </style>

  <!-- Solution / Benefits -->
  <section id="semantic-nexus" class="py-24 px-6 bg-warm">
    <div class="max-w-6xl mx-auto">

      <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">The Semantic Nexus</div>
      <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em; max-width: 640px">One <span class="text-brand-600">truth.</span> For every team.<br>For every decision.</h2>
      <p class="text-lg text-ink/55 mb-12" style="max-width: 560px">We build the data foundation underneath your business. Not another dashboard, but the layer that makes every dashboard, report, and KPI trustworthy.</p>

      <!-- Before / After -->
      <div class="grid md:grid-cols-2 gap-4 mb-10">

        <div class="bg-cream rounded-xl p-8 border border-ink/10">
          <div class="flex items-center gap-2 font-mono text-xs text-ink/40 uppercase tracking-wider mb-5">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            Before MAXQ
          </div>
          <ul class="flex flex-col gap-0">
            {['Metrics defined differently across departments', 'Manual exports and reconciliation every month', 'Dashboards that break when someone changes a column', 'No one knows which number is "the real one"', 'Data questions need a developer to answer'].map(item => (
              <li class="flex gap-3 text-sm text-ink/55 py-2.5 border-b border-ink/8 last:border-0">
                <span class="text-ink/30 font-bold shrink-0">✗</span>{item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-cream rounded-xl p-8 border border-brand-600">
          <div class="flex items-center gap-2 font-mono text-xs text-brand-600 uppercase tracking-wider mb-5">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            After MAXQ
          </div>
          <ul class="flex flex-col gap-0">
            {['Every metric defined once, visible to everyone', 'Board decks pull automatically, no scramble', 'Bad data caught before it reaches your boardroom', 'Finance, sales, and ops all see the same truth', 'Ask your data questions in plain English via AI'].map(item => (
              <li class="flex gap-3 text-sm text-ink/70 py-2.5 border-b border-ink/8 last:border-0">
                <span class="text-brand-600 font-bold shrink-0">✓</span>{item}
              </li>
            ))}
          </ul>
        </div>

      </div>


    </div>
  </section>

  <!-- Product Items -->
  <section id="features" class="py-24 px-6 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">What you get</div>
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Your data stack. All in <span class="text-brand-600">one place.</span></h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">Five components that together give your organisation complete visibility into its data — from raw sources to AI-powered querying.</p>
      </div>

      <!-- Top row: 3 cards -->
      <div class="grid md:grid-cols-3 gap-4 mb-4">

        <!-- Domain Reports -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Domain Reports</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">Three purpose-built reporting domains aligned to how companies are structured: <strong>Commerce Atlas</strong> (go-to-market, unit economics), <strong>Finance Atlas</strong> (margins, financial operations), and <strong>Operations Atlas</strong> (utilisation, capacity). Each delivers periodic dashboards and trend analysis tailored to the domain's owners and targets.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Domain+Reports" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

        <!-- Data Model Explorer -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 8h6M9 16h4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Data Model Explorer</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">A unified, navigable interface that maps your entire data architecture. Source tables are shown post-transformation with aggregations for fast analysis. Each critical metric gets its own dedicated page with a scorecard, numerator/denominator breakdown, and business context provided by the client.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data%20Model%20Explorer" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

        <!-- Data Entry Tests -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Data Entry Tests</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">Automated, client-specific tests that continuously validate data entries and business workflows. Each test is assigned an owner, a deeplink for direct resolution at the source, a context description, and a unique test ID — keeping data quality accountable and easy to communicate across teams.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data+Entry+Tests" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

      </div>

      <!-- Bottom row: 2 cards centred -->
      <div class="grid md:grid-cols-2 gap-4 md:max-w-3xl md:mx-auto">

        <!-- Pipeline Freshness -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">Pipeline Freshness</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">A live flowchart of your full data pipeline from extraction through transformation to consumption. Every stakeholder can see how data moves across your architecture — which systems are involved, what the current status is, and where bottlenecks occur. Invaluable when planning refactors or expansions.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus#Data+Freshness" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

        <!-- MCP Servers -->
        <div class="bg-warm rounded-xl p-7 flex flex-col border border-ink/8">
          <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-lg flex items-center justify-center mb-5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2">MCP Servers</h3>
          <p class="text-ink/60 text-sm leading-relaxed mb-4">We configure multiple Model Context Protocol servers tailored to specific use cases and agentic workflows — each one exposing the right slice of your semantic layer to the right AI system. Whether it's a customer-facing agent, an internal analyst assistant, or an automated reporting workflow, every MCP server is purpose-built for how that agent actually needs to query your data.</p>
          <a href="https://docs.maxqanalytics.io/Products/Semantic+Nexus" target="_blank" rel="noopener" class="mt-auto text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors">View in docs →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section id="stack" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-xs font-mono font-medium text-brand-600 uppercase tracking-widest mb-4">Tech stack</div>
        <h2 class="text-4xl font-bold text-ink mb-4" style="letter-spacing: -0.02em">Built on <span class="text-brand-600">best-in-class</span> tooling</h2>
        <p class="text-lg text-ink/55 max-w-2xl mx-auto">We work with the leading modern data stack tools, keeping clients in full control of their own infrastructure.</p>
      </div>

      <div class="flex flex-col md:flex-row items-stretch gap-0 md:min-h-[220px]">
        {[
          {
            stage: 'Extraction',
            color: 'bg-brand-50 border-brand-100',
            labelColor: 'text-brand-600',
            tools: [
              { src: '/logos/hevo.png', alt: 'Hevo Data', tip: 'No-code pipeline platform for extracting and syncing data from 150+ sources into your warehouse.', url: 'https://hevodata.com' },
              { src: '/logos/airbyte.svg', alt: 'Airbyte', tip: 'Open-source data integration platform for syncing data from APIs, databases and files.', url: 'https://airbyte.com' },
              { src: '/logos/debezium.png', alt: 'Debezium', tip: 'Open-source CDC platform that streams database changes in real time for event-driven data pipelines.', url: 'https://debezium.io' },
            ]
          },
          {
            stage: 'Warehouse',
            color: 'bg-brand-50 border-brand-100',
            labelColor: 'text-brand-600',
            tools: [
              { src: '/logos/bigquery.png', alt: 'BigQuery', tip: "Google's serverless, scalable cloud data warehouse built for fast SQL analytics at any scale.", url: 'https://cloud.google.com/bigquery' },
              { src: '/logos/snowflake.png', alt: 'Snowflake', tip: 'Cloud data platform with separated storage and compute, enabling flexible and cost-efficient scaling.', url: 'https://www.snowflake.com' },
              { src: '/logos/clickhouse.png', alt: 'ClickHouse', tip: 'High-performance columnar database optimised for real-time analytics on very large datasets.', url: 'https://clickhouse.com' },
            ]
          },
          {
            stage: 'Transformation & Semantics',
            color: 'bg-brand-50 border-brand-100',
            labelColor: 'text-brand-600',
            tools: [
              { src: '/logos/dbt.png', alt: 'dbt', tip: 'SQL-based transformation tool that lets analytics engineers build, test and document data models in version control.', url: 'https://www.getdbt.com' },
              { src: '/logos/cube.png', alt: 'Cube', tip: 'Semantic layer that defines business metrics centrally and exposes them consistently via API to any downstream tool.', url: 'https://cube.dev' },
              { src: '/logos/fabric.png', alt: 'Microsoft Fabric', tip: "Microsoft's all-in-one analytics platform combining data engineering, warehousing, and BI in a unified environment.", url: 'https://www.microsoft.com/en-us/microsoft-fabric' },
            ]
          },
          {
            stage: 'Data Consumption',
            color: 'bg-brand-50 border-brand-100',
            labelColor: 'text-brand-600',
            tools: [
              { src: '/logos/data-studio.png', alt: 'Data Studio', cls: 'h-6 w-auto object-contain max-w-[140px]', tip: "Google's free BI tool for building interactive, shareable dashboards connected directly to your data sources.", url: 'https://lookerstudio.google.com' },
              { src: '/logos/powerbi.png', alt: 'Power BI', cls: 'h-8 w-auto object-contain max-w-[120px]', tip: "Microsoft's business intelligence platform for creating rich reports and dashboards across your organisation.", url: 'https://powerbi.microsoft.com' },
