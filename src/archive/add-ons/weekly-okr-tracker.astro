  .krp-ini-impact-badge.krp-high     { background: var(--krp-greenFaint); color: var(--krp-green); }
  .krp-ini-impact-badge.krp-medium   { background: var(--krp-amberFaint); color: var(--krp-amber); }
  .krp-ini-impact-badge.krp-inactive { background: rgba(168,162,158,.12); color: var(--krp-textMut); }

  .krp-comments-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  .krp-comments-col     { display: flex; flex-direction: column; gap: 10px; }
  .krp-col-label { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 2px; }
  .krp-col-label.krp-green { color: var(--krp-green); }
  .krp-col-label.krp-red   { color: var(--krp-red); }
  .krp-comment-card {
    background: var(--krp-white); border: 1px solid var(--krp-cardBdr);
    border-radius: 12px; padding: 14px 16px;
  }
  .krp-comment-card.krp-positive { border-top: 3px solid var(--krp-green); }
  .krp-comment-card.krp-negative { border-top: 3px solid var(--krp-red); }
  .krp-comment-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .krp-comment-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .krp-positive .krp-comment-dot { background: var(--krp-green); }
  .krp-negative .krp-comment-dot { background: var(--krp-red); }
  .krp-comment-client {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 14px; font-weight: 700; color: var(--krp-dark); letter-spacing: -.01em;
  }
  .krp-comment-delta { display: flex; align-items: center; gap: 6px; margin-left: auto; flex-shrink: 0; }
