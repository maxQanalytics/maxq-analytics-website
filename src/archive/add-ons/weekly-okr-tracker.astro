  .krp-ini-desc  { font-size: 11px; color: var(--krp-textSec); line-height: 1.55; margin-top: 4px; }
  .krp-ini-due   { font-size: 11px; color: var(--krp-textSec); font-weight: 500; padding-top: 1px; }
  .krp-ini-delivery-date { font-size: 10px; color: var(--krp-textMut); margin-top: 3px; margin-bottom: 4px; }
