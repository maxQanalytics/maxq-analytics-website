<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script is:inline>
  (function () {
    const dataLabelPlugin = {
      id: 'dataLabelPlugin',
      afterDatasetsDraw(chart) {
        const ctx = chart.ctx;
        ctx.save();
        chart.data.datasets.forEach((dataset, di) => {
          const opts = dataset.dataLabels;
          if (!opts || opts.display === false) return;
          const meta = chart.getDatasetMeta(di);
          if (meta.hidden) return;
          ctx.font = '600 10px "DM Sans", system-ui, sans-serif';
          ctx.textAlign = 'center';
          meta.data.forEach((el, idx) => {
            const raw = dataset.data[idx];
            if (raw === null || raw === undefined) return;
            const label  = opts.formatter ? opts.formatter(raw) : String(raw);
            const align  = opts.align || 'top';
            const offset = opts.offset !== undefined ? opts.offset : 6;
            ctx.fillStyle = opts.color || '#A8A29E';
            if (align === 'top') { ctx.textBaseline = 'bottom'; ctx.fillText(label, el.x, el.y - offset); }
            else                 { ctx.textBaseline = 'top';    ctx.fillText(label, el.x, el.y + offset); }
          });
        });
        ctx.restore();
      }
    };
    Chart.register(dataLabelPlugin);

    const labels = [
      ['4 Apr','n=15'],['10 Apr','n=16'],['17 Apr','n=15'],
      ['24 Apr','n=17'],['1 May','n=18'],['8 May','n=20'],['15 May','n=18'],
      '22 May','29 May','5 Jun','12 Jun','19 Jun','26 Jun'
    ];

    const krActuals     = [3.20,3.30,3.50,3.30,2.80,3.00,3.30,null,null,null,null,null,null];
    const krExpect      = [null,null,null,null,null,null,3.30,3.30,3.60,3.70,3.90,4.10,4.20];
    const krTarget      = labels.map(() => 4.00);
    const krLow         = [2.50,2.58,2.67,2.75,2.83,2.92,3.00,3.08,3.17,3.25,3.33,3.42,3.50];
    const krHigh        = [3.00,3.08,3.17,3.25,3.33,3.42,3.50,3.58,3.67,3.75,3.83,3.92,4.00];
    const scoreActuals  = [73,77,83,77,60,67,77,null,null,null,null,null,null];
    const scoreExpect   = [null,null,null,null,null,null,77,77,87,90,97,103,107];
    const scoreTarget   = labels.map(() => 100);
    const scoreLow      = [50,53,56,58,61,64,67,69,72,75,78,81,83];
    const scoreHigh     = [67,69,72,75,78,81,83,86,89,92,94,97,100];

    function dl(formatter, align, color) {
      return { formatter, align, offset: 6, color: color || '#A8A29E' };
    }

    function makeOpts(yMin, yMax, yFn) {
      return {
        responsive: true, maintainAspectRatio: false,
        layout: { padding: { top: 22, bottom: 4 } },
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0D0A19', titleColor: '#A8A29E', bodyColor: '#fff',
            padding: 10, borderColor: 'rgba(255,255,255,.08)', borderWidth: 1,
            callbacks: { label: ctx => ctx.parsed.y !== null ? ` ${ctx.dataset.label}: ${yFn(ctx.parsed.y)}` : null }
          }
        },
        scales: {
          x: { grid: { color: '#EFE9E4' }, ticks: { font: { size: 9.5 }, color: '#1A1712', maxRotation: 0 } },
          y: { min: yMin, max: yMax, grid: { color: '#EFE9E4' }, ticks: { font: { size: 10 }, color: '#1A1712', callback: yFn } }
        }
      };
    }

    const krOpts = makeOpts(1, 5, v => v.toFixed(1));
    krOpts.plugins.tooltip.filter = item => item.datasetIndex < 3;

    new Chart(document.getElementById('krChart'), {
      type: 'line',
      data: { labels, datasets: [
        { label:'Target',      data: krTarget,  borderColor:'#0D0A19', borderWidth:1, pointRadius:0, tension:0, spanGaps:true, dataLabels:{display:false} },
        { label:'Actuals',     data: krActuals, borderColor:'#6D4BEF', borderWidth:2, pointRadius:2.5, pointBackgroundColor:'#6D4BEF', tension:0.3, spanGaps:false, dataLabels: dl(v=>v.toFixed(2),'top','#6D4BEF') },
        { label:'Expectation', data: krExpect,  borderColor:'#8B7EE8', borderWidth:2, borderDash:[6,4], pointRadius:2, pointBackgroundColor:'#8B7EE8', tension:0.3, spanGaps:false, dataLabels: dl(v=>v.toFixed(2),'bottom','#8B7EE8') },
        { label:'Low',  data:krLow,  borderColor:'transparent', borderWidth:0, pointRadius:0, tension:0.3, spanGaps:true, fill:'origin', backgroundColor:'rgba(239,68,68,0.14)',  dataLabels:{display:false} },
        { label:'Mid',  data:krLow,  borderColor:'transparent', borderWidth:0, pointRadius:0, tension:0.3, spanGaps:true, fill:'+1',     backgroundColor:'rgba(234,179,8,0.15)',  dataLabels:{display:false} },
        { label:'High', data:krHigh, borderColor:'transparent', borderWidth:0, pointRadius:0, tension:0.3, spanGaps:true, fill:'end',    backgroundColor:'rgba(34,197,94,0.14)',  dataLabels:{display:false} }
      ]},
      options: krOpts
    });

    const sOpts = makeOpts(0, 133, v => v + '%');
    sOpts.plugins.tooltip.filter = item => item.datasetIndex < 3;

    new Chart(document.getElementById('scoreChart'), {
      type: 'line',
      data: { labels, datasets: [
        { label:'Target',      data: scoreTarget,  borderColor:'#0D0A19', borderWidth:1, pointRadius:0, tension:0, spanGaps:true, dataLabels:{display:false} },
        { label:'Actuals',     data: scoreActuals, borderColor:'#6D4BEF', borderWidth:2, pointRadius:2.5, pointBackgroundColor:'#6D4BEF', tension:0.3, spanGaps:false, dataLabels: dl(v=>v+'%','top','#6D4BEF') },
        { label:'Expectation', data: scoreExpect,  borderColor:'#8B7EE8', borderWidth:2, borderDash:[6,4], pointRadius:2, pointBackgroundColor:'#8B7EE8', tension:0.3, spanGaps:false, dataLabels: dl(v=>v+'%','bottom','#8B7EE8') },
        { label:'Low',  data:scoreLow,  borderColor:'transparent', borderWidth:0, pointRadius:0, tension:0.3, spanGaps:true, fill:'origin', backgroundColor:'rgba(239,68,68,0.14)',  dataLabels:{display:false} },
        { label:'Mid',  data:scoreLow,  borderColor:'transparent', borderWidth:0, pointRadius:0, tension:0.3, spanGaps:true, fill:'+1',     backgroundColor:'rgba(234,179,8,0.15)',  dataLabels:{display:false} },
        { label:'High', data:scoreHigh, borderColor:'transparent', borderWidth:0, pointRadius:0, tension:0.3, spanGaps:true, fill:'end',    backgroundColor:'rgba(34,197,94,0.14)',  dataLabels:{display:false} }
      ]},
      options: sOpts
    });
  })();
</script>
