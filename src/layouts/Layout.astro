---
import { Analytics } from '@vercel/analytics/astro';
import '../styles/fonts.css';
import { SITE_URL, SITE_NAME, DEFAULT_DESCRIPTION, DESCRIPTIONS, SHARE_IMAGE, ORGANIZATION } from '../seo.mjs';
interface Props {
  title?: string;
  /** Shown under the page in search results and in link previews (Slack, LinkedIn). Defaults to the entry in src/seo.mjs. */
  description?: string;
  /** Share image path (1200 x 630). Defaults to the site card. */
  image?: string;
  /** Keep unlisted pages (preview versions) out of search engines. */
  noindex?: boolean;
}
const { title = SITE_NAME, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(SITE_URL);
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, site).href;
const description = Astro.props.description ?? DESCRIPTIONS[path] ?? DEFAULT_DESCRIPTION;
const image = new URL(Astro.props.image ?? SHARE_IMAGE, site).href;
const isHome = path === '/';
---
<!doctype html>
<html lang="en" class="scroll-smooth bg-ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Link previews (Slack, LinkedIn, WhatsApp, X all read Open Graph) -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maxq Analytics: agentic analytics on all your data" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Organisation details for search engines, homepage only -->
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(ORGANIZATION)} />}
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>

    <!-- PostHog (cookieless, memory persistence -> no consent banner required) -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog&&window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once identify reset group opt_in_capturing opt_out_capturing".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_BnwK8Gj2BbY5aLSZcDvJhXjyEqwCGKzaGgAiau7Mk3cR', {
        api_host: 'https://eu.i.posthog.com',
        persistence: 'memory',        // no cookies/localStorage -> no consent banner
        capture_pageview: true,
        autocapture: true
      });
    </script>

    <!-- Capture UTM params + referrer and attach to every PostHog event -->
    <script is:inline>
      (function () {
        var p = new URLSearchParams(location.search);
        var utm = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
          if (p.get(k)) utm[k] = p.get(k);
        });
        utm.referrer = document.referrer || 'direct';
        window.__maxq_utm = utm;
        if (window.posthog) posthog.register(utm);
      })();
    </script>
  </head>
  <body class="bg-cream text-ink font-sans antialiased">
    <slot />
  </body>
</html>
