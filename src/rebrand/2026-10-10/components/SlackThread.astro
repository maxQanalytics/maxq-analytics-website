---
// The Analytics Assistant example from the live add-on page (fictional coffee-shop
// chain), drawn as a Slack thread that plays itself when it scrolls into view:
// the question types out, the assistant "types", the answer and chart appear.
// `compact` shows the first question and answer only and loops (homepage hero).
interface Props { compact?: boolean; class?: string }
const { compact = false, class: cls = '' } = Astro.props;
const bars = [
  { store: 'Lower Manhattan', v: '€57.4K', h: 68 },
  { store: "Hell's Kitchen", v: '€62.1K', h: 76 },
  { store: 'Astoria', v: '€55.8K', h: 65 },
];
const rows = [
  ['Latte', '€31.6K', '6,740'],
  ['Cappuccino', '€24.9K', '5,410'],
  ['Chai latte', '€17.2K', '3,580'],
  ['Cold brew', '€14.8K', '3,290'],
  ['Espresso', '€11.3K', '4,120'],
];
const slackLogo = 'M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z';
---
<div class:list={['rb-slack rounded-[10px] overflow-hidden border border-black/40 shadow-2xl', cls]} style="background:#1a1d21" data-loop={compact ? 'true' : 'false'}>
  <div class="flex items-center gap-2 px-4 py-2.5 border-b" style="border-color: rgba(255,255,255,0.08)">
    <div class="w-3.5 h-3.5 rounded-sm flex items-center justify-center" style="background:#4a154b"><svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="white"><path d={slackLogo}/></svg></div>
    <span class="text-xs font-medium" style="color: rgba(255,255,255,0.55)">#analytics</span>
    {compact && <span class="ml-auto font-mono text-[10px] uppercase tracking-wider" style="color: rgba(255,255,255,0.3)">Analytics Assistant</span>}
  </div>
  <div class:list={['space-y-5', compact ? 'px-4 py-4' : 'px-5 py-5']}>

    <!-- Question -->
    <div class="rb-step flex gap-3" data-kind="user">
      <div class="shrink-0 w-8 h-8 rounded-md flex items-center justify-center text-white font-semibold text-xs" style="background:#3f4752">MK</div>
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline gap-2 mb-0.5"><span class="font-semibold text-sm text-white">Maya K.</span><span class="text-xs" style="color: rgba(255,255,255,0.3)">Customer Success · 9:12 AM</span></div>
        <p class="text-sm" style="color: rgba(255,255,255,0.88)"><span class="px-1 rounded" style="background: rgba(26,79,255,0.28); color:#a9bdff">@assistant</span> <span class="rb-type">what was total revenue in June, broken down by store?</span></p>
      </div>
    </div>

    <!-- Typing indicator -->
    <div class="rb-typing hidden items-center gap-2 pl-11 text-xs" style="color: rgba(255,255,255,0.4)"><span class="rb-dots"><i></i><i></i><i></i></span>Analytics Assistant is typing</div>

    <!-- Answer -->
    <div class="rb-step flex gap-3" data-kind="bot">
      <div class="shrink-0 w-8 h-8 rounded-md flex items-center justify-center text-white font-semibold text-xs" style="background:#1a4fff">AA</div>
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline gap-2 mb-1.5"><span class="font-semibold text-sm text-white">Analytics Assistant</span><span class="font-mono text-[9px] px-1.5 py-0.5 rounded" style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.45)">APP</span><span class="text-xs" style="color: rgba(255,255,255,0.3)">9:12 AM</span></div>
        <p class="text-sm mb-3" style="color: rgba(255,255,255,0.88)">Total revenue in June was <span class="font-semibold text-white">€175.3K</span> across three stores. Hell's Kitchen led at €62.1K; Astoria and Lower Manhattan were within €2K of each other.</p>
        <div class="rounded-md p-3.5 mb-3" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07)">
          <div class="flex items-center justify-between mb-3"><span class="font-mono text-[10px] uppercase tracking-wider" style="color: rgba(255,255,255,0.4)">Revenue · June · by store</span><span class="font-mono text-[10px]" style="color: rgba(255,255,255,0.3)">EUR</span></div>
          <div class="grid grid-cols-3 gap-4 items-end" style={`height:${compact ? 88 : 116}px`}>
            {bars.map((b) => (
              <div class="flex flex-col items-center justify-end h-full gap-1.5">
                <span class="font-mono text-[10px]" style="color: rgba(255,255,255,0.6)">{b.v}</span>
                <div class="rb-bar w-full rounded-t-sm" style={`--h:${b.h}%; background:#1a4fff`}></div>
              </div>
            ))}
          </div>
          <div class="grid grid-cols-3 gap-4 mt-2">
            {bars.map((b) => <span class="font-mono text-[9px] text-center uppercase tracking-wider truncate" style="color: rgba(255,255,255,0.38)">{b.store}</span>)}
          </div>
        </div>
        {!compact && (
          <Fragment>
            <div class="border-l-2 pl-3 mb-3 space-y-1" style="border-color: rgba(255,255,255,0.15)">
              <p class="text-xs" style="color: rgba(255,255,255,0.5)"><span class="font-semibold" style="color: rgba(255,255,255,0.75)">Scope &amp; metric</span> · Gross allocated turnover in EUR, 1–30 June, no-sales excluded, active stores only.</p>
              <p class="text-xs" style="color: rgba(255,255,255,0.5)"><span class="font-semibold" style="color: rgba(255,255,255,0.75)">Methodology</span> · Sum of order-line turnover per store, rounded in SQL. Query available in nao.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 font-mono text-[10px] px-2 py-1 rounded" style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.55)">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                revenue_by_store_june.csv
              </span>
              <span class="font-mono text-[10px] px-2 py-1 rounded border" style="border-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7)">Open in nao</span>
              <span class="font-mono text-[10px] px-2 py-1 rounded" style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.55)">👍 2</span>
            </div>
          </Fragment>
        )}
      </div>
    </div>

    {!compact && (
      <Fragment>
        <div class="rb-step flex items-center gap-3" data-kind="divider">
          <div class="flex-1 h-px" style="background: rgba(255,255,255,0.07)"></div>
          <span class="font-mono text-[10px] uppercase tracking-wider" style="color: rgba(255,255,255,0.28)">Follow-up in the same thread</span>
          <div class="flex-1 h-px" style="background: rgba(255,255,255,0.07)"></div>
        </div>
        <div class="rb-step flex gap-3" data-kind="user">
          <div class="shrink-0 w-8 h-8 rounded-md flex items-center justify-center text-white font-semibold text-xs" style="background:#3f4752">MK</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2 mb-0.5"><span class="font-semibold text-sm text-white">Maya K.</span><span class="text-xs" style="color: rgba(255,255,255,0.3)">9:14 AM</span></div>
            <p class="text-sm" style="color: rgba(255,255,255,0.88)"><span class="rb-type">and the top 5 products that month, with units sold?</span></p>
          </div>
        </div>
        <div class="rb-typing hidden items-center gap-2 pl-11 text-xs" style="color: rgba(255,255,255,0.4)"><span class="rb-dots"><i></i><i></i><i></i></span>Analytics Assistant is typing</div>
        <div class="rb-step flex gap-3" data-kind="bot">
          <div class="shrink-0 w-8 h-8 rounded-md flex items-center justify-center text-white font-semibold text-xs" style="background:#1a4fff">AA</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2 mb-1.5"><span class="font-semibold text-sm text-white">Analytics Assistant</span><span class="font-mono text-[9px] px-1.5 py-0.5 rounded" style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.45)">APP</span><span class="text-xs" style="color: rgba(255,255,255,0.3)">9:14 AM</span></div>
            <p class="text-sm mb-3" style="color: rgba(255,255,255,0.88)">Top 5 products in June, all stores. Latte alone is 18% of revenue.</p>
            <div class="rounded-md overflow-hidden" style="background: rgba(0,0,0,0.25)">
              <div class="grid grid-cols-3 px-3 py-1.5 border-b" style="border-color: rgba(255,255,255,0.06)">
                <span class="font-mono text-[9px] uppercase tracking-wider" style="color: rgba(255,255,255,0.32)">product</span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-right" style="color: rgba(255,255,255,0.32)">revenue</span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-right" style="color: rgba(255,255,255,0.32)">units</span>
              </div>
              {rows.map((r, i) => (
                <div class:list={['grid grid-cols-3 px-3 py-1.5', i < rows.length - 1 && 'border-b']} style="border-color: rgba(255,255,255,0.04)">
                  <span class="font-mono text-xs" style="color: rgba(255,255,255,0.65)">{r[0]}</span>
                  <span class="font-mono text-xs text-right" style="color: rgba(255,255,255,0.65)">{r[1]}</span>
                  <span class="font-mono text-xs text-right" style="color: rgba(255,255,255,0.65)">{r[2]}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Fragment>
    )}
  </div>
</div>

<style is:global>
  .rb-slack .rb-bar { height: var(--h); transition: height 1s cubic-bezier(.16,1,.3,1); }
  .rb-js .rb-slack:not(.rb-done) .rb-step { opacity: 0; transform: translateY(6px); }
  .rb-js .rb-slack:not(.rb-done) .rb-step:not(.rb-shown) .rb-bar { height: 0; }
  .rb-slack .rb-step { transition: opacity .45s ease, transform .45s ease; }
  .rb-js .rb-slack .rb-step.rb-shown { opacity: 1; transform: none; }
  .rb-dots { display: inline-flex; gap: 3px; }
  .rb-dots i { width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,0.45); animation: rbDot 1s infinite ease-in-out; }
  .rb-dots i:nth-child(2) { animation-delay: .15s; } .rb-dots i:nth-child(3) { animation-delay: .3s; }
  @keyframes rbDot { 0%, 60%, 100% { opacity: .25; transform: none; } 30% { opacity: 1; transform: translateY(-2px); } }
</style>
<script is:inline>
  (function () {
    var me = document.currentScript.previousElementSibling;
    while (me && !(me.classList && me.classList.contains('rb-slack'))) me = me.previousElementSibling;
    if (!me || me.dataset.wired) return;
    me.dataset.wired = '1';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) { me.classList.add('rb-done'); return; }
    var loop = me.dataset.loop === 'true';
    var steps = Array.prototype.slice.call(me.querySelectorAll('.rb-step'));
    var typers = Array.prototype.slice.call(me.querySelectorAll('.rb-typing'));
    steps.forEach(function (s) { var t = s.querySelector('.rb-type'); if (t) t.dataset.full = t.textContent; });
    function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
    function reset() {
      steps.forEach(function (s) { s.classList.remove('rb-shown'); var t = s.querySelector('.rb-type'); if (t) t.textContent = ''; });
      typers.forEach(function (t) { t.classList.add('hidden'); t.classList.remove('flex'); });
    }
    async function typeOut(el) {
      var full = el.dataset.full;
      for (var i = 1; i <= full.length; i++) { el.textContent = full.slice(0, i); await wait(28); }
    }
    async function play() {
      reset();
      var ti = 0;
      for (var i = 0; i < steps.length; i++) {
        var s = steps[i], kind = s.dataset.kind;
        if (kind === 'bot') {
          var ty = typers[ti++];
          if (ty) { ty.classList.remove('hidden'); ty.classList.add('flex'); await wait(1300); ty.classList.add('hidden'); ty.classList.remove('flex'); }
        }
        s.classList.add('rb-shown');
        var t = s.querySelector('.rb-type');
        if (t) { await wait(250); await typeOut(t); await wait(350); }
        else await wait(kind === 'bot' ? 900 : 300);
      }
      if (loop) { await wait(7000); play(); }
    }
    var io = new IntersectionObserver(function (en) {
      if (en[0].isIntersecting) { io.disconnect(); play(); }
    }, { threshold: 0.35 });
    io.observe(me);
  })();
</script>
