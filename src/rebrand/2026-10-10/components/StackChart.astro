<style is:global>
  @keyframes rbFlow { to { stroke-dashoffset: -20; } }
  @keyframes rbBand { to { stroke-dashoffset: -40; } }
  #rb-stack path[marker-end] { stroke-dasharray: 4 6; }
  .rb-in #rb-stack path[marker-end], #rb-stack.rb-in path[marker-end] { animation: rbFlow 1.1s linear infinite; }
  #rb-stack.rb-in rect[stroke-dasharray] { animation: rbBand 6s linear infinite; }
  @media (prefers-reduced-motion: reduce) { #rb-stack path[marker-end] { stroke-dasharray: none; animation: none !important; } #rb-stack rect { animation: none !important; } }
  .sx-wrap { display: flex; flex-wrap: wrap; gap: 14px 16px; }
  .sx-card .sx-wrap { margin-bottom: 18px; }
  .sx-card .sx-wrap:last-child { margin-bottom: 0; }
  .sx-chip { position: relative; display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 10px;
    background: #fff; border: 1px solid rgba(10,10,15,0.35); border-radius: 4px; font-size: 13px; font-weight: 500; color: #0a0a0f; white-space: nowrap; }
  .sx-chip img { height: 18px; width: auto; object-fit: contain; }
  .sx-chip.sx-self { border-color: rgba(26,79,255,0.6); }
  .sx-tool { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    flex: 1 1 128px; min-width: 128px; min-height: 58px; padding: 8px 10px; background: #fff; border: 1px solid #0a0a0f; border-radius: 4px; }
  .sx-tool img { max-width: 110px; width: auto; object-fit: contain; }
  .sx-tool small { font-size: 11px; line-height: 1.1; color: #3d3b38; text-align: center; }
  .sx-os { position: absolute; right: -6px; bottom: -8px; display: inline-flex; align-items: center; gap: 3px; height: 16px; padding: 0 5px 0 4px;
    border-radius: 8px; background: #e9f6e5; border: 0.8px solid #a9d9a2; font-family: 'DM Mono', monospace; font-size: 8px; letter-spacing: 0.04em; font-weight: 400; color: #0a0a0f; }
  .sx-os i { display: inline-block; width: 7px; height: 7px; border: 2px solid #3da639; border-bottom-color: transparent; border-radius: 50%; transform: rotate(45deg); }
</style>
