---
// The tech-stack flow chart of the live homepage (src/diagrams/tech-stack-2026-10-09h.svg,
// rendered by scripts/render-tech-stack.mjs), with motion added in CSS only: the
// connectors carry dashes that flow towards the consumers, and the dashed
// Semantic Nexus band slowly circulates. Phones get the same stacked cards as live.
import rawSvg from '../../../diagrams/tech-stack-2026-10-09h.svg?raw';
import { BASE } from '../config.mjs';
// Links inside the chart stay inside this edition
const stackSvg = rawSvg.replace(/href="\/add-ons\//g, `href="${BASE}/add-ons/`);
---
<div id="rb-stack" class="hidden md:block rb-reveal">
  <Fragment set:html={stackSvg} />
</div>
<div id="rb-stack-tip" class="pointer-events-none fixed z-50 max-w-xs bg-ink text-white text-xs rounded-md px-3 py-2 leading-relaxed shadow-lg" style="display:none">
  <strong class="block font-medium text-sm mb-0.5"></strong>
  <span class="text-white/80"></span>
</div>
<script is:inline>
  (function () {
    var tip = document.getElementById('rb-stack-tip'), tn = tip.querySelector('strong'), tt = tip.querySelector('span');
    function place(e) {
      var r = tip.getBoundingClientRect(), x = e.clientX + 14, y = e.clientY + 14;
      if (x + r.width > innerWidth - 8) x = e.clientX - r.width - 14;
      if (y + r.height > innerHeight - 8) y = e.clientY - r.height - 14;
      tip.style.left = x + 'px'; tip.style.top = y + 'px';
    }
    document.querySelectorAll('#rb-stack [data-tip-name]').forEach(function (n) {
      n.addEventListener('mouseenter', function (e) { tn.textContent = n.getAttribute('data-tip-name'); tt.textContent = n.getAttribute('data-tip-text'); tip.style.display = 'block'; place(e); });
      n.addEventListener('mousemove', place);
      n.addEventListener('mouseleave', function () { tip.style.display = 'none'; });
    });
  })();
</script>

