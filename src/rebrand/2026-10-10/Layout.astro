---
// Layout for the 2026-10-10 rebrand edition: white background, ink text, one
// brand colour (brand-600, #1a4fff). Always noindex: the edition is unlisted.
import '../../styles/fonts.css';
import { SITE_NAME, DEFAULT_DESCRIPTION, DESCRIPTIONS } from '../../seo.mjs';
import { BASE, EDITION_DATE } from './config.mjs';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
interface Props {
  title?: string;
}
const { title = SITE_NAME } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const livePath = path.replace(BASE, '') || '/';
const description = DESCRIPTIONS[livePath] ?? DEFAULT_DESCRIPTION;
---
<!doctype html>
<html lang="en" class="scroll-smooth bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline>document.documentElement.classList.add('rb-js');</script>
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>

    <!-- PostHog (cookieless, memory persistence -> no consent banner required) -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog&&window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once identify reset group opt_in_capturing opt_out_capturing".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_BnwK8Gj2BbY5aLSZcDvJhXjyEqwCGKzaGgAiau7Mk3cR', {
        api_host: 'https://eu.i.posthog.com',
        persistence: 'memory',
        capture_pageview: true,
        autocapture: true
      });
    </script>
    <script is:inline>
      (function () {
        var p = new URLSearchParams(location.search);
        var utm = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
          if (p.get(k)) utm[k] = p.get(k);
        });
        utm.referrer = document.referrer || 'direct';
        utm.edition = 'rebrand-2026-10-10';
        window.__maxq_utm = utm;
        if (window.posthog) posthog.register(utm);
      })();
    </script>
  </head>
  <body class="bg-white text-ink font-sans antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <div class="fixed bottom-3 left-3 z-40 font-mono text-[10px] uppercase tracking-wider bg-ink text-white px-2.5 py-1 rounded-md opacity-80 pointer-events-none">Rebrand preview · {EDITION_DATE}</div>

    <script is:inline>
      // Reveal on scroll, count-up numbers. Content is visible without JS (rb-js gate).
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.rb-reveal');
        function countUp(el) {
          var target = el.getAttribute('data-count');
          var m = target.match(/^([^0-9]*)([0-9.]+)(.*)$/);
          if (!m || reduce) return;
          var pre = m[1], num = parseFloat(m[2]), post = m[3], dec = (m[2].split('.')[1] || '').length;
          var t0 = null, dur = 1400;
          function step(ts) {
            if (!t0) t0 = ts;
            var k = Math.min(1, (ts - t0) / dur);
            var e = 1 - Math.pow(1 - k, 3);
            el.textContent = pre + (num * e).toFixed(dec) + post;
            if (k < 1) requestAnimationFrame(step); else el.textContent = target;
          }
          requestAnimationFrame(step);
        }
        if (!('IntersectionObserver' in window) || reduce) {
          els.forEach(function (el) { el.classList.add('rb-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            en.target.classList.add('rb-in');
            en.target.querySelectorAll('[data-count]').forEach(countUp);
            io.unobserve(en.target);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <style is:global>
      :root { --rb-brand: #1a4fff; --rb-line: rgba(10,10,15,0.09); --rb-soft: #f7f7f8; }
      .rb-h1 { font-weight: 500; letter-spacing: -0.035em; line-height: 1.02; font-size: clamp(42px, 6.2vw, 80px); }
      .rb-h2 { font-weight: 500; letter-spacing: -0.03em; line-height: 1.08; font-size: clamp(30px, 3.6vw, 46px); }
      .rb-h3 { font-weight: 500; letter-spacing: -0.015em; line-height: 1.25; }
      .rb-label { font-family: 'DM Mono', ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(10,10,15,0.48); }
      .rb-link { color: var(--rb-brand); font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; }
      .rb-link:hover { text-decoration: underline; text-underline-offset: 3px; }
      .rb-btn { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 6px; font-size: 14px; font-weight: 500; transition: background-color .15s, border-color .15s; white-space: nowrap; }
      .rb-btn-primary { background: var(--rb-brand); color: #fff; }
      .rb-btn-primary:hover { background: #1440cc; }
      .rb-btn-ghost { border: 1px solid rgba(10,10,15,0.16); color: #0a0a0f; background: #fff; }
      .rb-btn-ghost:hover { border-color: rgba(10,10,15,0.4); }
      .rb-line { border-color: var(--rb-line); }
      .rb-grid-cells { display: grid; gap: 1px; background: var(--rb-line); border: 1px solid var(--rb-line); }
      .rb-grid-cells > * { background: #fff; }
      /* Product frame: window chrome, image fading out at the bottom */
      .rb-frame { border: 1px solid rgba(10,10,15,0.12); border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 1px 2px rgba(10,10,15,0.04), 0 24px 60px -24px rgba(10,10,15,0.18); }
      .rb-frame-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; border-bottom: 1px solid rgba(10,10,15,0.08); background: #fafafa; }
      .rb-frame-bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(10,10,15,0.13); display: block; }
      .rb-fade { -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%); mask-image: linear-gradient(to bottom, #000 55%, transparent 100%); }
      .rb-fade-soft { -webkit-mask-image: linear-gradient(to bottom, #000 75%, transparent 100%); mask-image: linear-gradient(to bottom, #000 75%, transparent 100%); }
      /* Reveal on scroll */
      .rb-js .rb-reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s cubic-bezier(.16,1,.3,1); }
      .rb-js .rb-reveal.rb-in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { .rb-js .rb-reveal { opacity: 1; transform: none; transition: none; } }
    </style>
  </body>
</html>
